---
import {placeById,placeImage,placeEditUrl} from '../data/PlaceCatalog';
import SceneStage from './studio/SceneStage.astro';
import BroadcastStage from './studio/BroadcastStage.astro';
interface Props { relaxationOnly?: boolean; }
const { relaxationOnly = false } = Astro.props;
const scenes = [
  { id:'bali-jungle-pavilion',name:'Balinese Pavilion',mood:'Rain falls. Warm mist rises through the jungle.' },
  { id:'show',name:'Podcast & stream',mood:'A branded setting for your show.' },
  { id:'lighthouse-retreat',name:'Lighthouse Retreat',mood:'A sheltered place beside the sea.' },
  { id:'snow-cabin',name:'Snow Cabin',mood:'Warm indoors. Snow beyond the glass.' },
].filter(scene => !relaxationOnly || scene.id !== 'show');
const initial = scenes[0];
---
<div class="atmosphere" data-hero-atmosphere>
  <div class="scene" data-scene={initial.id}>
    <div class="show-stage" data-show-stage hidden={initial.id !== 'show'} aria-label="Example show layout with camera guides"><BroadcastStage /></div>
    <div class="bali-stage" data-bali-stage><SceneStage sceneId="forest" name="Balinese Jungle Pavilion" assetId="bali-jungle-pavilion" stageId="hero-bali-stage" exitButton={false} /></div>
    {scenes.filter(scene => scene.id !== 'bali-jungle-pavilion' && scene.id !== 'show').map((scene, index) => <img src={placeImage(placeById(scene.id)!)} alt={`${scene.name} atmosphere`} width="1024" height="576" hidden data-scene-image={scene.id} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />)}
    <span class="preview-label" data-preview-label>Live scene · Tropical rain & rising mist</span>
    <div class="scene-caption" aria-live="polite"><h2 data-scene-name>{initial.name}</h2><p data-scene-mood>{initial.mood}</p></div>
  </div>
  <div class="comparison-controls"><button type="button" data-bali-effects aria-pressed="false">Play effects</button><span>Compare with the original image · Silent preview</span></div>
  <div class="scene-controls" role="group" aria-label="Choose an atmosphere preview">
    {scenes.map((scene,index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-scene-choice={scene.id} data-mood={scene.mood} data-href={scene.id === 'show' ? '/studio/podcast/' : scene.id === 'bali-jungle-pavilion' ? '/scene-lab/bali/' : placeEditUrl(placeById(scene.id)!)}>{scene.name}</button>)}
    <a href="/scene-lab/bali/" data-scene-link>Explore this scene →</a>
  </div>
</div>
<script>
import {createTropicalWeather} from '../lib/weather/TropicalWeather';
import {registerRuntimeCleanup} from '../lib/runtime/RuntimeLifecycle';
document.querySelectorAll<HTMLElement>('[data-hero-atmosphere]').forEach(root=>{
 const stage=root.querySelector<HTMLElement>('[data-bali-stage]')!;
 const canvas=stage.querySelector<HTMLCanvasElement>('canvas')!;
 const toggle=root.querySelector<HTMLButtonElement>('[data-bali-effects]')!;
 const comparison=root.querySelector<HTMLElement>('.comparison-controls')!;
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
 let selected='bali-jungle-pavilion',enabled=!reduced.matches,visible=true;
 const weather=createTropicalWeather(canvas,()=>{});
 const broadcast=root.querySelector<HTMLElement>('.broadcast-stage');
 if(broadcast){broadcast.dataset.screen='live';broadcast.dataset.guides='true';broadcast.dataset.motion='still';}
 function sync(){weather.setEnabled(enabled&&visible&&selected==='bali-jungle-pavilion');toggle.setAttribute('aria-pressed',String(enabled));toggle.textContent=enabled?'Effects on · Compare original':'Effects off · Play atmosphere';}
 toggle.addEventListener('click',()=>{enabled=!enabled;sync();});
 root.querySelectorAll<HTMLButtonElement>('[data-scene-choice]').forEach(button=>button.addEventListener('click',()=>{
  selected=button.dataset.sceneChoice!;stage.hidden=selected!=='bali-jungle-pavilion';comparison.hidden=stage.hidden;
  root.querySelector<HTMLElement>('[data-show-stage]')!.hidden=selected!=='show';
  root.querySelectorAll<HTMLImageElement>('[data-scene-image]').forEach(img=>{img.hidden=img.dataset.sceneImage!==selected;});
  root.querySelectorAll<HTMLButtonElement>('[data-scene-choice]').forEach(other=>other.setAttribute('aria-pressed',String(other===button)));
  root.querySelector<HTMLElement>('[data-scene]')!.dataset.scene=selected;
  root.querySelector<HTMLElement>('[data-scene-name]')!.textContent=button.textContent;
  root.querySelector<HTMLElement>('[data-preview-label]')!.textContent=selected==='show'?'Podcast & stream · Example':selected==='bali-jungle-pavilion'?'Live scene · Tropical rain & rising mist':'Scene preview';
  root.querySelector<HTMLElement>('[data-scene-mood]')!.textContent=button.dataset.mood!;
  const link=root.querySelector<HTMLAnchorElement>('[data-scene-link]')!;link.href=button.dataset.href!;link.textContent=selected==='show'?'Open podcast studio →':selected==='bali-jungle-pavilion'?'Explore this scene →':'Edit this scene →';sync();
 }));
 const observer=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;sync();},{threshold:0});observer.observe(root);
 function preference(){if(reduced.matches){enabled=false;sync();}}
 reduced.addEventListener('change',preference);registerRuntimeCleanup(()=>{observer.disconnect();reduced.removeEventListener('change',preference);weather.destroy();});sync();
});
</script>
<style>
  .atmosphere { width:100%; border:1px solid #ffffff24; border-radius:20px; overflow:hidden; background:#10151f; box-shadow:0 24px 80px #0004; }
  .show-stage { position:absolute; inset:0; display:grid; place-items:center; background:#09121c; }
  .show-stage[hidden] { display:none; }
  .show-stage :global(.broadcast-stage) { width:100%; border-radius:0; }
  .show-stage :global(.broadcast-camera) { width:38%; left:8%; top:35%; }
  .show-stage :global(.broadcast-camera--guest) { left:54%; }
  .scene[data-scene="show"] .scene-caption { display:none; }
  .scene[data-scene="show"]::after { display:none; }
  .scene[data-scene="show"] .preview-label { top:8px; left:8px; z-index:6; }
  .bali-stage { position:absolute; inset:0; }
  .bali-stage[hidden] { display:none; }
  .bali-stage :global(.preview-stage) { width:100%; height:100%; border:0; border-radius:0; }
  .scene { position:relative; height:auto; aspect-ratio:16/9; overflow:hidden; --accent:#ffbb65; }
  .scene[data-scene="forest"] { --accent:#c7ed9a; }
  .scene[data-scene="ocean"] { --accent:#a3eaff; }
  .scene img { width:100%; height:100%; object-fit:cover; display:block; }
  .scene img[hidden] { display:none; }
  .scene::after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,#0004,transparent 35%,#050912d9); pointer-events:none; }
  .preview-label { position:absolute; z-index:2; top:20px; left:22px; font-size:10px; text-transform:uppercase; letter-spacing:.14em; color:#fff; background:#07101d88; padding:8px 10px; border-radius:20px; }
  .scene-caption { position:absolute; z-index:2; bottom:24px; left:24px; right:24px; }
  .scene-caption h2 { margin:0 0 8px; font-size:clamp(24px,3vw,32px); line-height:1.1; color:#fff; letter-spacing:-.03em; }
  .scene-caption p { margin:0; font-size:14px; color:#e2e8f0; line-height:1.5; }
  .haze { position:absolute; inset:0; background:radial-gradient(ellipse at 65% 40%,var(--accent),transparent 65%); opacity:.12; animation:breathe 8s ease-in-out infinite alternate; }
  .motes { position:absolute; inset:0; }
  .motes i { position:absolute; left:var(--x); bottom:-10px; width:3px; height:3px; background:var(--accent); border-radius:50%; box-shadow:0 0 8px var(--accent); animation:float var(--duration) var(--delay) linear infinite; }
  .scene-controls { display:flex; flex-wrap:wrap; align-items:center; gap:6px; padding:14px; }
  button { border:1px solid transparent; background:transparent; color:#aebccc; font:inherit; font-size:12px; padding:9px 12px; border-radius:9px; cursor:pointer; }
  button[aria-pressed="true"] { background:#26364d; border-color:#6888aa66; color:white; }
  .scene-controls a { margin-left:auto; padding:9px 4px; font-size:12px; color:#8bdcfb; text-decoration:none; }
  button:focus-visible, a:focus-visible { outline:2px solid #7dd3fc; outline-offset:3px; }
  @keyframes float { from { transform:translate(0,0); opacity:0; } 15% { opacity:.8; } 85% { opacity:.5; } to { transform:translate(20px,-380px); opacity:0; } }
  @keyframes breathe { to { opacity:.22; transform:scale(1.08); } }

  @media(prefers-reduced-motion:reduce) { .haze,.motes i { animation:none; } .motes { display:none; } }
</style>

<style>.bali-stage :global(.preview-fog),.bali-stage :global(.scene-light),.bali-stage :global(.scene-tint){display:none}.comparison-controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 14px;border-bottom:1px solid #ffffff14}.comparison-controls[hidden]{display:none}.comparison-controls button{border:1px solid #76d5b366;color:#b7f1d9;min-height:40px}.comparison-controls span{font-size:11px;color:#9eafbf}.scene-controls button{min-height:40px}.scene-caption h2{font-size:clamp(22px,2.5vw,30px)}.scene-caption{bottom:16px;left:20px}.scene-caption p{font-size:12px}.preview-label{top:12px;left:14px;font-size:9px}</style>
