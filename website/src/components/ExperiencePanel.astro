<section
  class="experience-panel"
  aria-labelledby="experience-panel-title"
>
  <div class="panel-header">
    <div>
      <p class="panel-kicker">
        <span class="panel-dot" aria-hidden="true"></span>
        Live Studio preview
      </p>

      <h2 id="experience-panel-title">Studio Preview</h2>
    </div>

    <span class="panel-status" data-panel-status>Temple active</span>
  </div>

  <fieldset class="panel-group experience-selector">
    <legend>Experience</legend>

    <div class="experience-options">
      <label class="experience-option">
        <input
          type="radio"
          name="aether-experience"
          value="temple"
          checked
        />

        <span class="option-content">
          <span class="option-icon" aria-hidden="true">◇</span>

          <span>
            <strong>Temple</strong>
            <small>Focused and luminous</small>
          </span>
        </span>
      </label>

      <label class="experience-option">
        <input
          type="radio"
          name="aether-experience"
          value="forest"
        />

        <span class="option-content">
          <span class="option-icon" aria-hidden="true">△</span>

          <span>
            <strong>Forest</strong>
            <small>Organic and restorative</small>
          </span>
        </span>
      </label>

      <label class="experience-option">
        <input
          type="radio"
          name="aether-experience"
          value="ocean"
        />

        <span class="option-content">
          <span class="option-icon" aria-hidden="true">≈</span>

          <span>
            <strong>Ocean</strong>
            <small>Fluid and expansive</small>
          </span>
        </span>
      </label>

      <label class="experience-option">
        <input
          type="radio"
          name="aether-experience"
          value="christmas"
        />

        <span class="option-content">
          <span class="option-icon" aria-hidden="true">✦</span>

          <span>
            <strong>Christmas</strong>
            <small>Warm and quiet snowfall</small>
          </span>
        </span>
      </label>
    </div>
  </fieldset>

  <div class="control-list">
    <label class="switch-control">
      <span>
        <strong>Particles</strong>
        <small>Atmospheric energy points</small>
      </span>

      <input
        type="checkbox"
        data-particles-control
        checked
      />

      <span class="switch" aria-hidden="true">
        <span></span>
      </span>
    </label>

    <label class="switch-control">
      <span>
        <strong>Ambient glow</strong>
        <small>Responsive environmental light</small>
      </span>

      <input
        type="checkbox"
        data-glow-control
        checked
      />

      <span class="switch" aria-hidden="true">
        <span></span>
      </span>
    </label>
  </div>

  <div class="intensity-control">
    <div class="control-heading">
      <label for="aether-intensity">Intensity</label>
      <output for="aether-intensity" data-intensity-output>65%</output>
    </div>

    <input
      id="aether-intensity"
      type="range"
      min="10"
      max="100"
      value="65"
      step="1"
      data-intensity-control
    />

    <div class="range-labels" aria-hidden="true">
      <span>Subtle</span>
      <span>Immersive</span>
    </div>
  </div>

  <div class="panel-feedback" aria-live="polite">
    <span class="feedback-indicator" aria-hidden="true"></span>
    <span data-experience-feedback>
      Temple experience is active.
    </span>
  </div>

  <a
    class="panel-studio-link"
    href="/studio/experiences/temple/"
    data-open-studio
  >
    Open Temple in Studio →
  </a>
</section>

<script>
  type ExperienceName = 'temple' | 'forest' | 'ocean' | 'christmas';

  interface AetherState {
    experience: ExperienceName;
    particles: boolean;
    glow: boolean;
    intensity: number;
  }

  const STORAGE_KEY = 'create-aether-demo-state';

  const experienceNames: Record<ExperienceName, string> = {
    temple: 'Temple',
    forest: 'Forest',
    ocean: 'Ocean',
    christmas: 'Christmas',
  };

  const defaultState: AetherState = {
    experience: 'temple',
    particles: true,
    glow: true,
    intensity: 65,
  };

  const hero = document.querySelector<HTMLElement>('[data-aether-demo]');
  const panel = document.querySelector<HTMLElement>('.experience-panel');

  const experienceInputs =
    panel?.querySelectorAll<HTMLInputElement>(
      'input[name="aether-experience"]'
    );

  const particlesControl =
    panel?.querySelector<HTMLInputElement>('[data-particles-control]');

  const glowControl =
    panel?.querySelector<HTMLInputElement>('[data-glow-control]');

  const intensityControl =
    panel?.querySelector<HTMLInputElement>('[data-intensity-control]');

  const intensityOutput =
    panel?.querySelector<HTMLOutputElement>('[data-intensity-output]');

  const feedback =
    panel?.querySelector<HTMLElement>('[data-experience-feedback]');

  const panelStatus =
    panel?.querySelector<HTMLElement>('[data-panel-status]');

  const openStudioLink =
    panel?.querySelector<HTMLAnchorElement>('[data-open-studio]');

  function isExperienceName(value: unknown): value is ExperienceName {
    return value === 'temple' || value === 'forest' || value === 'ocean' || value === 'christmas';
  }

  function loadState(): AetherState {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);

      if (!saved) {
        return { ...defaultState };
      }

      const parsed = JSON.parse(saved);

      return {
        experience: isExperienceName(parsed.experience)
          ? parsed.experience
          : defaultState.experience,
        particles:
          typeof parsed.particles === 'boolean'
            ? parsed.particles
            : defaultState.particles,
        glow:
          typeof parsed.glow === 'boolean'
            ? parsed.glow
            : defaultState.glow,
        intensity:
          typeof parsed.intensity === 'number'
            ? Math.min(100, Math.max(10, parsed.intensity))
            : defaultState.intensity,
      };
    } catch {
      return { ...defaultState };
    }
  }

  let state: AetherState = loadState();

  function saveState(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      // The demo still works when local storage is unavailable.
    }
  }

  function updateSliderProgress(value: number): void {
    if (!intensityControl) {
      return;
    }

    const minimum = Number(intensityControl.min);
    const maximum = Number(intensityControl.max);
    const progress = ((value - minimum) / (maximum - minimum)) * 100;

    intensityControl.style.setProperty(
      '--range-progress',
      `${progress}%`
    );
  }

  function applyState(announce = true): void {
    if (!hero) {
      return;
    }

    const power = state.intensity / 100;
    const displayName = experienceNames[state.experience];

    hero.dataset.experience = state.experience;
    hero.dataset.particles = String(state.particles);
    hero.dataset.glow = String(state.glow);
    hero.style.setProperty('--aether-power', power.toFixed(2));

    experienceInputs?.forEach((input) => {
      input.checked = input.value === state.experience;
    });

    if (particlesControl) {
      particlesControl.checked = state.particles;
    }

    if (glowControl) {
      glowControl.checked = state.glow;
    }

    if (openStudioLink) {
      openStudioLink.href =
        `/studio/experiences/${state.experience}/`;

      openStudioLink.textContent =
        `Open ${displayName} in Studio →`;
    }

    if (intensityControl) {
      intensityControl.value = String(state.intensity);
    }

    if (intensityOutput) {
      intensityOutput.value = `${state.intensity}%`;
      intensityOutput.textContent = `${state.intensity}%`;
    }

    updateSliderProgress(state.intensity);

    if (panelStatus) {
      panelStatus.textContent = `${displayName} active`;
    }

    if (feedback && announce) {
      feedback.textContent =
        `${displayName} experience active at ` +
        `${state.intensity}% intensity.`;
    }

    saveState();
  }

  function createParticles(): void {
    const container =
      hero?.querySelector<HTMLElement>('[data-aether-particles]');

    if (!container || container.children.length > 0) {
      return;
    }

    const particleCount = 26;

    for (let index = 0; index < particleCount; index += 1) {
      const particle = document.createElement('span');

      const left = 5 + Math.random() * 90;
      const top = 5 + Math.random() * 90;
      const size = 2 + Math.random() * 3;
      const delay = Math.random() * -12;
      const duration = 7 + Math.random() * 9;
      const drift = -18 + Math.random() * 36;

      particle.style.setProperty('--particle-left', `${left}%`);
      particle.style.setProperty('--particle-top', `${top}%`);
      particle.style.setProperty('--particle-size', `${size}px`);
      particle.style.setProperty('--particle-delay', `${delay}s`);
      particle.style.setProperty('--particle-duration', `${duration}s`);
      particle.style.setProperty('--particle-drift', `${drift}px`);

      container.appendChild(particle);
    }
  }

  experienceInputs?.forEach((input) => {
    input.addEventListener('change', () => {
      if (!isExperienceName(input.value)) {
        return;
      }

      state = {
        ...state,
        experience: input.value,
      };

      applyState();
    });
  });

  particlesControl?.addEventListener('change', () => {
    state = {
      ...state,
      particles: particlesControl.checked,
    };

    applyState();
  });

  glowControl?.addEventListener('change', () => {
    state = {
      ...state,
      glow: glowControl.checked,
    };

    applyState();
  });

  intensityControl?.addEventListener('input', () => {
    state = {
      ...state,
      intensity: Number(intensityControl.value),
    };

    applyState(false);

    if (feedback) {
      feedback.textContent =
        `${experienceNames[state.experience]} intensity: ` +
        `${state.intensity}%.`;
    }
  });

  createParticles();
  applyState(false);
</script>

<style>
