      linear-gradient(
        to bottom,
        transparent,
        var(--aether-accent, #66e3ff)
      );
    box-shadow:
      0 0 14px var(--aether-accent, #66e3ff),
      0 0 34px var(--aether-secondary, #4f7cff);
  }

  .experience-panel::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 0%,
        color-mix(
          in srgb,
          var(--aether-accent, #66e3ff) 12%,
          transparent
        ),
        transparent 38%
      );
  }

  .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 26px;
  }

  .panel-kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 7px;
    color: #9ca9c4;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .panel-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--aether-accent, #66e3ff);
