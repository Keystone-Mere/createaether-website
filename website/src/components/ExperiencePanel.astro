  }

  .panel-header h2 {
    margin: 0;
    color: #f7f4ee;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .panel-status {
    padding: 6px 9px;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.035);
    color: #aeb8cc;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .panel-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .panel-group legend,
  .control-heading label {
    margin-bottom: 11px;
