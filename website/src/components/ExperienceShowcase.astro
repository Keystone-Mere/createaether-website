---
import { experiences } from '../data/experiences';
---

<section
  class="experience-showcase"
  aria-labelledby="experience-showcase-title"
>
  <div class="experience-showcase__heading">
    <div>
      <p class="experience-showcase__eyebrow">Playable experiences</p>
      <h2 id="experience-showcase-title">
        Explore Aether in action.
      </h2>
    </div>

    <p class="experience-showcase__intro">
      Open a ready-made atmosphere and change its audio, lighting,
      particles and environmental effects in real time.
    </p>
  </div>

  <div class="experience-showcase__grid">
    {
      experiences.map((experience, index) => (
        <a class="experience-card" href={experience.href}>
          <div class="experience-card__top">
            <span class="experience-card__number">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="experience-card__status">Playable</span>
          </div>

          <h3>{experience.name}</h3>
          <p>{experience.description}</p>

          <span class="experience-card__link">
            Open experience <span aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </div>

  <a class="experience-showcase__action" href="/studio/">
    Open the Atmosphere Composer <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .experience-showcase {
    padding: 7rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.12);
  }

  .experience-showcase__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 4rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .experience-showcase__eyebrow {
    margin: 0 0 1rem;
   color: #818cf8;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .experience-showcase h2 {
    max-width: 12ch;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .experience-showcase__intro {
    max-width: 34rem;
    margin: 0;
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .experience-showcase__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .experience-card {
    min-height: 15rem;
    padding: 1.4rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1rem;
    background:
      radial-gradient(
        circle at top right,
        rgba(37, 99, 235, 0.12),
        transparent 48%
      ),
      rgba(10, 15, 26, 0.72);
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .experience-card:hover {
    transform: translateY(-3px);
    border-color: rgba(34, 211, 238, 0.42);
    background-color: rgba(13, 22, 38, 0.9);
  }

  .experience-card:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 3px;
  }

  .experience-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.75rem;
  }

  .experience-card__number {
    color: #22d3ee;
    font-family: monospace;
    font-size: 0.7rem;
  }

  .experience-card__status {
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(52, 211, 153, 0.25);
    border-radius: 999px;
    color: #6ee7b7;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .experience-card p {
    min-height: 4.5rem;
    margin: 0;
    color: #94a3b8;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .experience-card__link {
    display: inline-block;
    margin-top: 1.5rem;
    color: #67e8f9;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .experience-showcase__action {
    display: inline-block;
    margin-top: 1.75rem;
    color: #67e8f9;
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
  }

  .experience-showcase__action:hover {
    color: #cffafe;
  }

  @media (max-width: 900px) {
    .experience-showcase__heading {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .experience-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .experience-showcase {
      padding: 5rem 0;
    }

    .experience-showcase__grid {
      grid-template-columns: 1fr;
    }

    .experience-card {
      min-height: auto;
    }

    .experience-card p {
      min-height: auto;
    }
  }
</style>
