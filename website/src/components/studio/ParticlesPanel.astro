---
import { experiences } from '../../data/experiences';
const { experience } = Astro.props;
const particles = experience.particles;
---

<div class="panel">

<h2>Particles</h2>

<label class="toggle-row"><input id="particles-toggle" type="checkbox" checked={experience.atmosphere.particles} /> Particles On</label>
<label for="particle-preset-select">Preset</label><select id="particle-preset-select">{experiences.map(item => <option value={item.particles.preset} selected={item.particles.preset === particles.preset}>{item.particles.preset.replaceAll('-', ' ')}</option>)}</select>
<label>
Particle count
<output id="particle-count-value">{particles.count}</output>
</label>

<input
id="particle-count-control"
type="range"
aria-label="count"
min="0"
max="300"
step="1"
value={particles.count}
/>

<h3 class="particle-heading">Appearance</h3>
<label for="particles-colour-control">Colour</label>
<div class="colour-picker"><input id="particles-colour-control" type="color" value={particles.colour} aria-label="Particle colour" /><output id="particles-colour-value">{particles.colour.toUpperCase()}</output></div>
<label>Opacity</label>

<div class="dual-range" data-dual-range role="group" aria-label="Opacity range">
    <div class="dual-range-values"><span>Min <output id="particle-min-opacity-value">{particles.minOpacity}</output></span><span>Max <output id="particle-max-opacity-value">{particles.maxOpacity}</output></span></div>
    <div class="dual-range-track">
        <div class="dual-range-fill"></div>
        <input id="particle-min-opacity-control" type="range" aria-label="Minimum particle opacity" min="0" max="1" step="0.05" value={particles.minOpacity} />
        <input id="particle-max-opacity-control" type="range" aria-label="Maximum particle opacity" min="0" max="1" step="0.05" value={particles.maxOpacity} />
    </div>
</div>

<label>
Glow
<output id="particle-glow-value">{particles.glow}</output>
</label>

<input
id="particle-glow-control"
type="range"
aria-label="glow"
min="0"
max="20"
step="0.5"
value={particles.glow}
/>

<label>Size</label>

<div class="dual-range" data-dual-range role="group" aria-label="Size range">
    <div class="dual-range-values"><span>Min <output id="particle-min-radius-value">{particles.minRadius}</output></span><span>Max <output id="particle-max-radius-value">{particles.maxRadius}</output></span></div>
    <div class="dual-range-track">
        <div class="dual-range-fill"></div>
        <input id="particle-min-radius-control" type="range" aria-label="Minimum particle size" min="0" max="10" step="0.05" value={particles.minRadius} />
        <input id="particle-max-radius-control" type="range" aria-label="Maximum particle size" min="0" max="10" step="0.05" value={particles.maxRadius} />
    </div>
</div>

<h3 class="particle-heading">Movement</h3>
<label>
Drift
<output id="particle-drift-value">{particles.drift}</output>
</label>

<input
id="particle-drift-control"
type="range"
aria-label="drift"
min="0"
max="20"
step="0.5"
value={particles.drift}
/>

<label>Speed</label>

<div class="dual-range" data-dual-range role="group" aria-label="Speed range">
    <div class="dual-range-values"><span>Min <output id="particle-min-speed-value">{particles.minSpeed}</output></span><span>Max <output id="particle-max-speed-value">{particles.maxSpeed}</output></span></div>
    <div class="dual-range-track">
        <div class="dual-range-fill"></div>
        <input id="particle-min-speed-control" type="range" aria-label="Minimum particle speed" min="0" max="50" step="1" value={particles.minSpeed} />
        <input id="particle-max-speed-control" type="range" aria-label="Maximum particle speed" min="0" max="50" step="1" value={particles.maxSpeed} />
    </div>
</div>

<h3 class="particle-heading">Particle lifetime</h3>

<div class="dual-range" data-dual-range role="group" aria-label="Particle lifetime range">
    <div class="dual-range-values"><span>Min <output id="particle-min-lifetime-value">{particles.minLifetime}s</output></span><span>Max <output id="particle-max-lifetime-value">{particles.maxLifetime}s</output></span></div>
    <div class="dual-range-track">
        <div class="dual-range-fill"></div>
        <input id="particle-min-lifetime-control" type="range" aria-label="Minimum particle particle lifetime" min="1" max="30" step="1" value={particles.minLifetime} />
        <input id="particle-max-lifetime-control" type="range" aria-label="Maximum particle particle lifetime" min="1" max="30" step="1" value={particles.maxLifetime} />
    </div>
</div>

</div>

<style>

.panel{
background:#10182c;
border:1px solid rgba(255,255,255,.08);
border-radius:18px;
padding:1.5rem;
}

.panel h2{
margin-top:0;
}

label{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:1rem;
margin-bottom:.45rem;
}

input[type="range"]{
width:100%;
}

input[type="color"]{
width:100%;
height:44px;
border:none;
background:none;
cursor:pointer;
}

.control-row{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:1rem;
}

.dual-values{
display:flex;
justify-content:space-between;
color:#94a3b8;
font-size:.82rem;
margin-bottom:.5rem;
}

.range-pair{
display:grid;
grid-template-columns:1fr 1fr;
gap:.85rem;
margin-bottom:.75rem;
}

.range-pair > div{
min-width:0;
}

.range-pair span{
display:flex;
justify-content:space-between;
color:#94a3b8;
font-size:.75rem;
margin-bottom:.35rem;
}

.range-pair output{
display:block;
margin-bottom:.25rem;
font-size:.82rem;
}

output{
color:#7dd3fc;
font-weight:700;
}


.dual-range { margin-bottom:.65rem; }
.dual-range-values { display:flex; justify-content:space-between; font-size:.8rem; color:#cbd5e1; }
.dual-range-values output { margin-left:.25rem; }
.dual-range-track { position:relative; height:44px; touch-action:none; cursor:pointer; }
.dual-range-track::before, .dual-range-fill { content:""; position:absolute; top:19px; height:6px; border-radius:4px; left:10px; right:10px; background:#475569; }
.dual-range-fill { left:calc(10px + (100% - 20px) * var(--range-min,0)); right:calc(10px + (100% - 20px) * (1 - var(--range-max,1))); background:#7dd3fc; }
.dual-range-track input[type="range"] { appearance:none; -webkit-appearance:none; position:absolute; inset:0; width:100%; height:44px; padding:0; margin:0; background:transparent; pointer-events:none; }
.dual-range-track input::-webkit-slider-runnable-track { height:6px; background:transparent; }
.dual-range-track input::-webkit-slider-thumb { appearance:none; -webkit-appearance:none; width:20px; height:20px; border-radius:50%; background:#93c5fd; border:2px solid #10182c; margin-top:-7px; }
.dual-range-track input::-moz-range-track { height:6px; background:transparent; }
.dual-range-track input::-moz-range-thumb { width:16px; height:16px; border-radius:50%; background:#93c5fd; border:2px solid #10182c; }
.dual-range-track input:focus-visible { outline:2px solid #38bdf8; outline-offset:2px; border-radius:6px; z-index:2; }
</style>
