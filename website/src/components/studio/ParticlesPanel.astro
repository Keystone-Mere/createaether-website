---
const { experience } = Astro.props;
const particles = experience.particles;
---

<div class="panel">

<h2>Particles</h2>

<div class="control-row">
<label>Enabled</label>

<input
type="checkbox"
checked={experience.atmosphere.particles}
/>
</div>

<label>
Count
<output id="particle-count-value">{particles.count}</output>
</label>

<input
id="particle-count-control"
type="range"
min="0"
max="150"
step="1"
value={particles.count}
/>

<label>
Glow
<output id="particle-glow-value">{particles.glow}</output>
</label>

<input
id="particle-glow-control"
type="range"
min="0"
max="20"
step="0.5"
value={particles.glow}
/>

<label>Radius</label>

<div class="range-pair">
    <div>
        <span>Minimum</span>
        <output id="particle-min-radius-value">
            {particles.minRadius}
        </output>

        <input
            id="particle-min-radius-control"
            type="range"
            min="0.5"
            max="10"
            step="0.5"
            value={particles.minRadius}
        />
    </div>

    <div>
        <span>Maximum</span>
        <output id="particle-max-radius-value">
            {particles.maxRadius}
        </output>

        <input
            id="particle-max-radius-control"
            type="range"
            min="0.5"
            max="10"
            step="0.5"
            value={particles.maxRadius}
        />
    </div>
</div>

<label>Speed</label>

<div class="range-pair">
    <div>
        <span>Minimum</span>
        <output id="particle-min-speed-value">
            {particles.minSpeed}
        </output>

        <input
            id="particle-min-speed-control"
            type="range"
            min="0"
            max="50"
            step="1"
            value={particles.minSpeed}
        />
    </div>

    <div>
        <span>Maximum</span>
        <output id="particle-max-speed-value">
            {particles.maxSpeed}
        </output>

        <input
            id="particle-max-speed-control"
            type="range"
            min="0"
            max="50"
            step="1"
            value={particles.maxSpeed}
        />
    </div>
</div>

<label>
Drift
<output id="particle-drift-value">{particles.drift}</output>
</label>

<input
id="particle-drift-control"
type="range"
min="0"
max="20"
step="0.5"
value={particles.drift}
/>

<label>Opacity</label>

<div class="range-pair">
    <div>
        <span>Minimum</span>
        <output id="particle-min-opacity-value">
            {particles.minOpacity}
        </output>

        <input
            id="particle-min-opacity-control"
            type="range"
            min="0"
            max="1"
            step="0.05"
            value={particles.minOpacity}
        />
    </div>

    <div>
        <span>Maximum</span>
        <output id="particle-max-opacity-value">
            {particles.maxOpacity}
        </output>

        <input
            id="particle-max-opacity-control"
            type="range"
            min="0"
            max="1"
            step="0.05"
            value={particles.maxOpacity}
        />
    </div>
</div>

<label>Lifetime</label>

<div class="range-pair">
    <div>
        <span>Minimum</span>
        <output id="particle-min-lifetime-value">
            {particles.minLifetime}s
        </output>

        <input
            id="particle-min-lifetime-control"
            type="range"
            min="1"
            max="30"
            step="1"
            value={particles.minLifetime}
        />
    </div>

    <div>
        <span>Maximum</span>
        <output id="particle-max-lifetime-value">
            {particles.maxLifetime}s
        </output>

        <input
            id="particle-max-lifetime-control"
            type="range"
            min="1"
            max="30"
            step="1"
            value={particles.maxLifetime}
        />
    </div>
</div>

</div>

<style>

.panel{
background:#10182c;
border:1px solid rgba(255,255,255,.08);
border-radius:18px;
padding:1.5rem;
}

.panel h2{
margin-top:0;
}

label{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:1rem;
margin-bottom:.45rem;
}

input[type="range"]{
width:100%;
}

input[type="color"]{
width:100%;
height:44px;
border:none;
background:none;
cursor:pointer;
}

.control-row{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:1rem;
}

.dual-values{
display:flex;
justify-content:space-between;
color:#94a3b8;
font-size:.82rem;
margin-bottom:.5rem;
}

.range-pair{
display:grid;
grid-template-columns:1fr 1fr;
gap:.85rem;
margin-bottom:.75rem;
}

.range-pair > div{
min-width:0;
}

.range-pair span{
display:flex;
justify-content:space-between;
color:#94a3b8;
font-size:.75rem;
margin-bottom:.35rem;
}

.range-pair output{
display:block;
margin-bottom:.25rem;
font-size:.82rem;
}

output{
color:#7dd3fc;
font-weight:700;
}

</style>
