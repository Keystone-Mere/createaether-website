---
interface Props {
    features: string[];
}

const { features } = Astro.props;
---

<section class="planned" aria-label="Planned features">
    <p class="planned-heading">Planned <span>Future editor controls</span></p>
    <ul>
        {features.map((feature) => <li>{feature}</li>)}
    </ul>
</section>

<style>
    .planned {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, .12);
        color: #aab8cb;
    }

    .planned-heading {
        margin: 0 0 .8rem;
        color: #d2deed;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .planned-heading span {
        display: block;
        margin-top: .3rem;
        color: #aab8cb;
        font-size: .72rem;
        font-weight: 400;
        letter-spacing: normal;
        text-transform: none;
    }

    ul {
        display: grid;
        gap: .5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        padding: .65rem .8rem;
        border: 1px solid rgba(255, 255, 255, .1);
        border-radius: 8px;
        background: rgba(255, 255, 255, .035);
        font-size: .85rem;
        line-height: 1.35;
    }
</style>
