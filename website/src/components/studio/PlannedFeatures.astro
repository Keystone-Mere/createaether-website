---
interface Props { features: string[]; }
const { features } = Astro.props;
---
<ul class="planned" aria-label="Coming soon">{features.map(feature => <li>{feature} — Coming soon.</li>)}</ul>
<style>
.planned {display:grid;gap:8px;margin:24px 0 0;padding:0;list-style:none;color:#94a3b8;}
li {padding:10px 12px;border-radius:6px;background:#192537;font-size:13px;line-height:1.4;font-weight:600;}
</style>
