---
import CardScene from './CardScene.astro';
interface Props {
  sceneId?: string;
  cover?: string;
  title: string;
  description: string;
  status?: string;
  href?: string;
  playHref?: string;
}
const { sceneId, cover, title, description, href, playHref } = Astro.props;
---
<article class="experience-card">
  {cover && (href ? (
    <a class="experience-card__image-link" href={href} aria-label={`Edit ${title} scene`}>
      {sceneId ? <CardScene sceneId={sceneId} name={title} /> : <img class="experience-card__cover" src={cover} alt="" width="1024" height="576" loading="lazy" />}
    </a>
  ) : (sceneId ? <CardScene sceneId={sceneId} name={title} /> : <img class="experience-card__cover" src={cover} alt="" width="1024" height="576" loading="lazy" />))}
  <div class="experience-card__content">
    <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    <p>{description}</p>
  </div>
  <div class="experience-card__footer">
    {playHref && <a class="experience-card__button" href={playHref}>Play scene</a>}
    {href ? <a class:list={["experience-card__button", {"experience-card__customise": !!playHref}]} href={href}>{playHref ? "Edit scene" : "Edit scene"}</a> : <button disabled>Open in Studio</button>}
  </div>
</article>
<style>
.experience-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid rgba(255,255,255,.08); border-radius: 18px; background: #10182c; overflow: hidden; transition: border-color .2s ease; }
.experience-card:hover { border-color: #2fa8ff; }
.experience-card__image-link { display: block; flex-shrink: 0; }
.experience-card__cover { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center; }
.experience-card__content { padding: 1.1rem 1.1rem 0; flex: 1; }
.experience-card h3 { margin: 0; color: #f8fafc; font-size: 1.15rem; line-height: 1.35; }
.experience-card h3 a { color: inherit; text-decoration: none; }
.experience-card h3 a:hover { color: #7dd3fc; }
.experience-card p { margin: .65rem 0 0; color: #94a3b8; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3.2em; }
.experience-card__footer { padding: 1rem 1.1rem 1.1rem; margin-top: auto; }
.experience-card__button, .experience-card button { display: flex; box-sizing: border-box; align-items: center; justify-content: center; width: 100%; min-height: 2.75rem; border: 0; border-radius: 10px; padding: .65rem .5rem; background: #2563eb; color: white; font: inherit; font-size: .9rem; line-height: 1.3; text-align: center; text-decoration: none; }
.experience-card__button:hover { background: #1d4ed8; }
.experience-card button:disabled { background: #27344f; color: #94a3b8; }
.experience-card a:focus-visible { outline: 2px solid #7dd3fc; outline-offset: -3px; }
</style>
