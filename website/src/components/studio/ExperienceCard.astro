---
interface Props {
  cover?: string;
  title: string;
  description: string;
  status: string;
  href?: string;
}

const {
  cover,
  title,
  description,
  status,
  href,
} = Astro.props;
---

<div class="experience-card">
    {cover && <img class="experience-card__cover" src={cover} alt="" width="1024" height="576" loading="lazy" />}
    <div class="experience-card__content">
        <h3>{title}</h3>

        <p>{description}</p>
    </div>

    <div class="experience-card__footer">
        <span class="experience-card__status">
            {status}
        </span>

        {
            href ? (
                <a class="experience-card__button" href={href}>
                    Open in Studio
                </a>
            ) : (
                <button type="button" disabled>
                    Open in Studio
                </button>
            )
        }
    </div>
</div>

<style>
.experience-card{
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    gap:1.5rem;

    padding:0 0 24px;
    overflow:hidden;

    background:#10182c;

    border:1px solid rgba(255,255,255,.08);

    border-radius:18px;

    transition:.25s ease;
}

.experience-card__cover { width:100%; height:403px; object-fit:cover; object-position:center; display:block; }
.experience-card__content, .experience-card__footer { margin-inline:24px; }
.experience-card__content { flex:1; }
.experience-card__button:focus-visible { outline:2px solid #7dd3fc; outline-offset:4px; }

.experience-card:hover{
    transform:translateY(-4px);

    border-color:#2fa8ff;
}

.experience-card h3{
    margin:0;

    color:white;

    font-size:1.2rem;
}

.experience-card p{
    margin:.75rem 0 0;

    color:#94a3b8;

    line-height:1.6;
}

.experience-card__footer{
    display:flex;

    justify-content:space-between;

    align-items:center;
}

.experience-card__status{

    color:#38bdf8;

    font-size:.8rem;

    font-weight:600;

    letter-spacing:.08em;

    text-transform:uppercase;
}

.experience-card button,
.experience-card__button{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:none;
    border-radius:10px;
    padding:.55rem 1rem;
    background:#2563eb;
    color:white;
    font:inherit;
    line-height:1;
    text-decoration:none;
    cursor:pointer;
    transition:.2s ease;
}

.experience-card button:hover,
.experience-card__button:hover{
    background:#1d4ed8;
}

.experience-card button:disabled{
    background:#27344f;
    color:#718096;
    cursor:not-allowed;
}
</style>
