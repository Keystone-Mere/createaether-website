---
interface ExperienceItem {
    id: string;
    name: string;
    description: string;
}

interface Props {
    experiences: ExperienceItem[];
    activeExperience: string;
}

const {
    experiences,
    activeExperience
} = Astro.props;
---

<div class="panel">
    <h2>Experiences</h2>

    <div class="experience-switcher">
        {
            experiences.map((experience) => (
                <button
                    type="button"
                    class:list={[
                        "experience-card",
                        experience.id === activeExperience &&
                            "experience-card--active"
                    ]}
                    data-experience-id={experience.id}
                >
                    <strong>{experience.name}</strong>
                    <small>{experience.description}</small>
                </button>
            ))
        }
    </div>
</div>

<style>
.experience-switcher{
    display:flex;
    flex-direction:column;
    gap:.75rem;
}

.experience-card{
    width:100%;
    padding:1rem;
    text-align:left;
    border-radius:12px;
    border:1px solid rgba(255,255,255,.08);
    background:#172036;
    color:#fff;
    cursor:pointer;
    transition:.2s;
}

.experience-card:hover{
    border-color:#38bdf8;
}

.experience-card--active{
    border-color:#22c55e;
    box-shadow:0 0 14px rgba(34,197,94,.25);
}

.experience-card strong{
    display:block;
    margin-bottom:.35rem;
}

.experience-card small{
    color:#94a3b8;
    line-height:1.4;
}
</style>
