---
const { experiences, activeExperience } = Astro.props;
---
<div class="experience-switcher">
    <label for="experience-selector">Choose experience</label>
    <select id="experience-selector">{experiences.map(experience => <option value={experience.id} selected={experience.id === activeExperience}>{experience.name}</option>)}</select>
    <div hidden>{experiences.map(experience => <button type="button" data-experience-id={experience.id}>{experience.name}</button>)}</div>
</div>
<script>
const selector = document.querySelector('#experience-selector');
selector?.addEventListener('change', () => {
    if (!(selector instanceof HTMLSelectElement)) return;
    const button = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-experience-id]')).find(button => button.dataset.experienceId === selector.value);
    button?.click();
});
</script>
<style>
.experience-switcher {min-width:200px;max-width:100%;}
label {display:block; font-size:13px; font-weight:600; margin-bottom:8px;}
select {width:100%; min-height:44px; padding:10px 14px; background:#192537; border:1px solid #475569; border-radius:8px; color:white;}
@media(max-width:700px){.experience-switcher{width:200px;}}
</style>
