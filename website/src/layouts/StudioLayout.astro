---
import PostHog from '../components/posthog.astro';
import Sidebar from '../components/studio/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aether Atmosphere Composer',
  description = 'Build and shape immersive atmospheres in a local MVP workspace.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta name="description" content={description} />
    <title>{title} | Create Aether</title>
    <PostHog />
  </head>

  <body>
    <div class="studio-shell">
      <Sidebar />

      <main class="studio-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: #050914;
    color: #e2e8f0;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: #050914;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(
        circle at 85% 0%,
        rgba(14, 165, 233, 0.1),
        transparent 32rem
      ),
      radial-gradient(
        circle at 55% 100%,
        rgba(59, 130, 246, 0.07),
        transparent 30rem
      ),
      #050914;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  .studio-shell {
    min-height: 100vh;
  }

  .studio-main {
    min-height: 100vh;
    margin-left: 17rem;
    padding: 1.75rem;
  }

  @media (max-width: 900px) {
    .studio-main {
      margin-left: 0;
      padding: 1rem;
    }
  }
</style>
