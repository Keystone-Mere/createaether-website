---
import StudioLayout from '../../layouts/StudioLayout.astro';
import TempleJourney from '../../components/studio/TempleJourney.astro';
import temple from '../../data/experiences/temple.json';
import { audioTracks } from '../../data/audio/tracks';

const relaxationExperience = { ...temple, audio: { ...temple.audio, track: 'om-so-hum', layerVolume: 0 } };
const track = audioTracks.find((item) => item.id === relaxationExperience.audio.track);
---

<StudioLayout title="Guided relaxation" description="Take a few minutes to unwind with an immersive environment, ambient sound and a guided practice." privacyMode>
    <section class="visitor-page">
      <div class="hero-copy">
        <p class="eyebrow">AETHER / GUIDED RELAXATION</p>
        <h1>Guided relaxation</h1>
        <p>Take a few minutes to unwind with an immersive environment, ambient sound and a guided practice. Headphones recommended.</p>
      </div>

      <a class="garden-session-card" href="/studio/evening-wind-down/">
        <img src="/images/experience-covers/night-garden.jpg" alt="Lantern-lit courtyard garden with a stone fountain" width="1672" height="941" loading="lazy" />
        <div><span>FIVE-MINUTE SESSION</span><h2>Evening wind-down</h2><p>Settle into the Night Garden with gentle wind and on-screen guidance.</p><strong>Explore Night Garden →</strong></div>
      </a>

      <div class="preview-stage" data-scene="temple" id="experience-preview-stage" role="group" aria-label="Temple atmosphere with warm light and drifting particles">
        <div class="preview-scene">
        <img class="preview-scene-image" src="/images/experience-covers/temple.jpg" alt="" aria-hidden="true" />
        <div class="scene-tint" aria-hidden="true"></div>
        <div class="candle-light candle-light--left" aria-hidden="true"></div>
        <div class="candle-light candle-light--back" aria-hidden="true"></div>
        <div class="candle-light candle-light--right" aria-hidden="true"></div>
        <div class="candle-light candle-light--front" aria-hidden="true"></div>
        <canvas class="preview-canvas" aria-hidden="true"></canvas>

        <div class="preview-fog preview-fog--one" aria-hidden="true"></div>
        <div class="preview-fog preview-fog--two" aria-hidden="true"></div>
        </div>
        <div class="immersive-toolbar"><button type="button" id="guided-fullscreen">Enter full screen</button><label><input type="checkbox" id="guided-show-cues" checked /> Show guidance</label><label><input type="checkbox" id="guided-show-clock" checked /> Show timer</label></div>
        <div class="stage-caption"><strong>Temple</strong><span id="temple-stage-cue">Sound and atmosphere begin with your session.</span></div>
        <div class="stage-clock" id="temple-stage-clock" role="timer" aria-label="Time remaining" aria-hidden="true">05:00</div>
        <div class="stage-controls" id="temple-stage-controls" hidden>
          <button type="button" id="temple-stage-toggle">Pause session</button>
          <button type="button" id="temple-stage-exit">End session</button>
        </div>

      <div class="volume-row">
        <label for="experience-volume">Om So Hum volume</label>
        <input id="experience-volume" type="range" min="0" max="100" step="1" value={temple.audio.volume} />
        <output id="experience-volume-value" for="experience-volume">{temple.audio.volume}%</output>
      </div>

      </div>
      <p id="guided-display-status" role="status"></p>
      <TempleJourney visitor />
      <p class="page-footer"><a href="/studio/experiences/temple/">Open Temple in the editor</a></p>
    </section>

    <audio id="experience-audio" src={track?.src ?? '/audio/om-so-hum.mp3'} data-track-id={relaxationExperience.audio.track} preload="metadata" loop hidden></audio>
    <script id="temple-configuration" type="application/json" set:html={JSON.stringify(relaxationExperience)}></script>
</StudioLayout>

<script>
  import { createStudioRuntime } from '../../lib/studio/StudioRuntime';
  import type { Experience } from '../../lib/models/Experience';

  const audio = document.querySelector<HTMLAudioElement>('#experience-audio');
  const volume = document.querySelector<HTMLInputElement>('#experience-volume');
  const config = document.querySelector<HTMLScriptElement>('#temple-configuration');
  const stage = document.querySelector<HTMLElement>('#experience-preview-stage');
  if (audio && volume && config && stage) {
    const { experienceRuntime, experienceLoader, experienceState } = createStudioRuntime({
      audioElement:audio,
      audioEnabledToggle:null,
      volumeControl:volume,
      volumeValue:document.querySelector('#experience-volume-value'),
      particlesToggle:null,
      lightingToggle:null,
      fogToggle:null,
      previewStage:stage,
      previewCanvas:stage.querySelector('canvas'),
      particlesStatus:null,
      lightingStatus:null,
      fogStatus:null
    });
    experienceLoader.load(JSON.parse(config.textContent ?? '{}') as Experience);
    volume.addEventListener('input',()=>experienceState.update());
    const fullscreen = document.querySelector<HTMLButtonElement>('#guided-fullscreen');
    const cues = document.querySelector<HTMLInputElement>('#guided-show-cues');
    const clock = document.querySelector<HTMLInputElement>('#guided-show-clock');
    const status = document.querySelector<HTMLElement>('#guided-display-status');
    let hideTimer: number | undefined;
    let keyboardInteraction = false;
    const reveal = () => {
      stage.classList.remove('controls-idle');
      window.clearTimeout(hideTimer);
      if (document.body.classList.contains('temple-session-active') && !audio.paused) {
        hideTimer = window.setTimeout(() => {
          // Preserve keyboard access; pointer interaction can hide controls after playback starts.
          if (!keyboardInteraction) stage.classList.add('controls-idle');
        }, 3500);
      }
    };
    fullscreen?.addEventListener('click', async () => {
      try {
        if (document.fullscreenElement === stage) await document.exitFullscreen();
        else await stage.requestFullscreen();
      } catch { if (status) status.textContent = 'Full screen is unavailable in this browser.'; }
    });
    const onFullscreen = () => {
      if (fullscreen) fullscreen.textContent = document.fullscreenElement === stage ? 'Exit full screen' : 'Enter full screen';
      reveal();
    };
    document.addEventListener('fullscreenchange', onFullscreen);
    cues?.addEventListener('change', () => stage.classList.toggle('hide-guidance', !cues.checked));
    clock?.addEventListener('change', () => stage.classList.toggle('hide-clock', !clock.checked));
    stage.addEventListener('pointermove', () => { keyboardInteraction = false; reveal(); });
    stage.addEventListener('pointerdown', () => { keyboardInteraction = false; reveal(); });
    stage.addEventListener('focusin', reveal);
    stage.addEventListener('focusout', reveal);
    stage.addEventListener('keydown', () => { keyboardInteraction = true; reveal(); });
    audio.addEventListener('play', reveal);
    audio.addEventListener('pause', reveal);
    const sessionObserver = new MutationObserver(reveal);
    sessionObserver.observe(document.body, {attributes:true, attributeFilter:['class']});
    let disposed=false;
    const dispose=()=>{
      if(disposed)return;
      disposed=true;
      window.clearTimeout(hideTimer);
      sessionObserver.disconnect();
      document.removeEventListener('fullscreenchange', onFullscreen);
      audio.pause();audio.currentTime=0;
      experienceRuntime.stop();experienceRuntime.destroy();
    };
    window.addEventListener('pagehide',dispose,{once:true});
    document.addEventListener('astro:before-swap',dispose,{once:true});
  }
</script>

<style>
  .garden-session-card{display:grid;grid-template-columns:minmax(180px,1fr) 1.6fr;gap:1.5rem;align-items:center;margin:0 0 2rem;padding:1rem;border:1px solid #476859;border-radius:18px;background:#0c211b;color:#eef6ef;text-decoration:none}
  .garden-session-card img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:10px}
  .garden-session-card span{font-size:.75rem;letter-spacing:.12em;color:#b9d5bd}.garden-session-card h2{margin:.5rem 0;font-size:1.6rem}.garden-session-card p{line-height:1.6;color:#c0d1c5}.garden-session-card strong{color:#b8efcf}
  .garden-session-card:hover{border-color:#b8efcf}.garden-session-card:focus-visible{outline:3px solid #b8efcf;outline-offset:4px}
  :global(body.temple-session-active) .garden-session-card{display:none}
  @media(max-width:600px){.garden-session-card{grid-template-columns:1fr;gap:1rem}}

  :global(:root){color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:#050914;color:#e2e8f0}
  :global(*){box-sizing:border-box}
  :global(body){margin:0;min-width:320px;background:radial-gradient(circle at 50% 15%,#132545 0%,#050914 55%)}
  :global(button),:global(input){font:inherit}
  .site-header{max-width:1120px;margin:auto;padding:1.4rem clamp(1rem,4vw,2rem);display:flex;align-items:center;justify-content:space-between;color:#9bb5d8;font-size:.85rem}
  .brand{color:#f4f8ff;text-decoration:none;font-weight:800;letter-spacing:.2em}
  .visitor-page{max-width:1120px;margin:auto;padding:2rem clamp(1rem,4vw,2rem) 5rem}
  .hero-copy{text-align:center;margin:1.25rem auto 2rem;max-width:680px}
  .eyebrow{color:#7dd3fc;font-size:.8rem;font-weight:700;letter-spacing:.2em}
  h1{font-size:clamp(2.25rem,6vw,4rem);line-height:1.1;letter-spacing:-.045em;margin:.5rem 0 1rem;color:white}
  .hero-copy>p:last-child{line-height:1.65;color:#c0d1e7}
  .preview-stage{--aether-lighting-colour:#e7c67a;--aether-stage-ambient:#e7c67a;--aether-lighting-glow-strength:18%;--aether-lighting-orb-strength:55%;--aether-lighting-shadow-strength:42%;--aether-lighting-pulse-duration:4s;--aether-fog-colour:#c9b58a;--aether-fog-opacity:.25;--aether-fog-blur:20px;--aether-fog-duration:14s;position:relative;min-height:clamp(260px,38vw,420px);overflow:hidden;border:1px solid #355178;border-radius:22px;background:radial-gradient(circle at 50% 48%,color-mix(in srgb,var(--aether-stage-ambient) 16%,transparent),transparent 34%),linear-gradient(180deg,#07101f,#101c32)}
  .preview-canvas{position:absolute;z-index:3;inset:0;width:100%;height:100%;pointer-events:none}
  .preview-glow{position:absolute;left:50%;top:48%;width:240px;height:240px;border-radius:50%;background:color-mix(in srgb,var(--aether-lighting-colour) var(--aether-lighting-glow-strength),transparent);filter:blur(30px);transform:translate(-50%,-50%);animation:glow var(--aether-lighting-pulse-duration) ease-in-out infinite}
  .preview-orb{position:absolute;z-index:2;left:50%;top:45%;width:95px;height:95px;border:1px solid #f1dcad;border-radius:50%;background:radial-gradient(circle at 38% 32%,white,color-mix(in srgb,var(--aether-lighting-colour) var(--aether-lighting-orb-strength),white) 18%,color-mix(in srgb,var(--aether-lighting-colour) 30%,transparent) 50%,transparent 74%);box-shadow:0 0 55px color-mix(in srgb,var(--aether-lighting-colour) var(--aether-lighting-shadow-strength),transparent);transform:translate(-50%,-50%);animation:float 5s ease-in-out infinite}
  .preview-stage--lighting-static .preview-glow{animation:none}
  .preview-stage--lighting-disabled .preview-glow{display:none}
  .preview-stage--fog-disabled .preview-fog{opacity:0}
  .preview-fog{position:absolute;z-index:1;left:-15%;bottom:15px;width:130%;height:82px;border-radius:50%;background:radial-gradient(ellipse,color-mix(in srgb,var(--aether-fog-colour) 65%,transparent),transparent 75%);filter:blur(var(--aether-fog-blur));opacity:var(--aether-fog-opacity);animation:fog var(--aether-fog-duration) ease-in-out infinite;pointer-events:none}
  .preview-fog--two{bottom:48px;opacity:.15;animation-direction:reverse}
  .stage-caption{position:absolute;z-index:4;bottom:1.4rem;left:1.5rem;right:1.5rem;display:flex;flex-direction:column;gap:.25rem;text-shadow:0 1px 9px #051020}
  .stage-caption strong{font-size:1.1rem}.stage-caption span{font-size:.85rem;color:#d5e0ee}
  .stage-clock{position:absolute;z-index:4;right:1.5rem;top:1.25rem;padding:.35rem .75rem;border:1px solid #b6d9ef88;border-radius:10px;background:#08182ab8;color:#f4f8ff;font-size:clamp(1.25rem,3vw,2rem);font-variant-numeric:tabular-nums;letter-spacing:.08em}
  .stage-controls{position:absolute;z-index:5;bottom:1.2rem;right:1.5rem;display:flex;gap:.5rem;flex-wrap:wrap;justify-content:flex-end}
  .stage-controls[hidden]{display:none}
  .stage-controls button{min-height:44px;padding:.6rem .9rem;border:1px solid #b6d9ef;border-radius:10px;background:#0c1d34ed;color:white;cursor:pointer}
  .stage-controls button:hover,.stage-controls button:focus-visible{background:#24446a;outline-color:#80d7ff}
  :global(body.temple-session-active) .hero-copy,:global(body.temple-session-active .temple-journey),:global(body.temple-session-active) .page-footer{display:none}
  :global(body.temple-session-active) .visitor-page{padding-top:.6rem;padding-bottom:1rem}
  :global(body.temple-session-active) .preview-stage{min-height:0}
  :global(body.temple-session-active) .stage-caption{bottom:5rem;max-width:65ch}
  .volume-row{display:flex;align-items:center;gap:1rem;padding:1rem 0 1.4rem;color:#cbd8e8;font-size:.9rem}
  .volume-row input{accent-color:#80d7ff;width:min(230px,45vw)}.volume-row output{min-width:3em;font-variant-numeric:tabular-nums}
  .page-footer{text-align:center;margin:2rem 0}.page-footer a{color:#9bdcff}
  @keyframes float{50%{transform:translate(-50%,-58%)}}
  @keyframes glow{50%{opacity:.7;transform:translate(-50%,-50%) scale(1.1)}}
  @keyframes fog{50%{transform:translateX(4%)}}
  @media(max-width:600px){.volume-row{flex-wrap:wrap}.site-header span{display:none}.stage-controls{left:1rem;right:1rem;bottom:1rem;justify-content:flex-start}.stage-caption{left:1rem;right:1rem}:global(body.temple-session-active) .stage-caption{bottom:6.5rem}}
  @media(prefers-reduced-motion:reduce){.preview-glow,.preview-orb,.preview-fog{animation:none}}
.preview-scene { position:absolute; inset:0; overflow:hidden; }
.preview-scene-image, .scene-tint, .candle-light { display:none; pointer-events:none; }
.preview-stage[data-scene="temple"] .preview-scene-image { display:block; position:absolute; inset:0; width:100%; height:100%; object-fit:fill; }
.preview-stage[data-scene="temple"] .preview-glow,
.preview-stage[data-scene="temple"] .preview-orb { display:none; }
.preview-stage[data-scene="temple"] .scene-tint { display:block; position:absolute; inset:0; background:var(--aether-environment-colour); opacity:.08; z-index:1; }
.preview-stage[data-scene="temple"] .candle-light { display:block; position:absolute; width:20%; height:32%; transform:translate(-50%,-50%); z-index:2; background:radial-gradient(ellipse, color-mix(in srgb,var(--aether-lighting-colour) 85%,transparent),transparent 70%); mix-blend-mode:screen; opacity:calc(var(--aether-lighting-intensity) * .6); animation:candle-shimmer var(--aether-lighting-pulse-duration, 4.7s) ease-in-out infinite alternate; }
.candle-light--left { left:10%; top:32%; }
.candle-light--back { left:44%; top:33%; animation-delay:-1.7s!important; }
.candle-light--right { left:86%; top:41%; animation-delay:-2.8s!important; }
.candle-light--front { left:7%; top:73%; animation-delay:-3.6s!important; }
.preview-stage[data-scene="temple"].preview-stage--lighting-disabled .candle-light { display:none; }
.preview-stage--lighting-static .candle-light { animation:none!important; }
.preview-stage[data-scene="temple"]:not(:fullscreen) { min-height:0; aspect-ratio:16/9; }
@keyframes candle-shimmer { 0% { opacity:calc(var(--aether-lighting-intensity) * .25); } 38% { opacity:calc(var(--aether-lighting-intensity) * .95); } 71% { opacity:calc(var(--aether-lighting-intensity) * .4); } 100% { opacity:calc(var(--aether-lighting-intensity) * .8); } }
@media (prefers-reduced-motion:reduce) { .candle-light { animation:none!important; } }



.preview-stage { min-height:0; aspect-ratio:16/9; --aether-environment-colour:#3a1f16; --aether-lighting-intensity:.82; }

.immersive-toolbar { position:absolute; z-index:6; top:1rem; left:1rem; display:flex; flex-wrap:wrap; align-items:center; gap:.75rem; padding:.5rem; border-radius:12px; background:#08182acc; }
.immersive-toolbar button { min-height:44px; padding:.6rem .9rem; border:1px solid #b6d9ef; border-radius:10px; background:#0c1d34ed; color:white; cursor:pointer; }
.immersive-toolbar label { display:flex; align-items:center; gap:.35rem; font-size:.85rem; }
.preview-stage .volume-row { position:absolute; z-index:6; bottom:1rem; left:1rem; margin:0; padding:.6rem; border-radius:12px; background:#08182acc; gap:.6rem; }
.preview-stage .volume-row input { width:130px; }
.stage-caption { bottom:5.5rem; }
.stage-controls { bottom:1rem; }
.preview-stage:fullscreen { width:100vw; height:100vh; min-height:0; max-height:none; aspect-ratio:auto; border:0; border-radius:0; background:#000; display:grid; place-items:center; }
.preview-stage:fullscreen .preview-scene { position:relative; inset:auto; width:min(100vw,177.7778vh); height:min(100vh,56.25vw); }
.immersive-toolbar, .stage-controls, .volume-row, .stage-caption, .stage-clock { transition:opacity .3s ease; }
.controls-idle .immersive-toolbar, .controls-idle .stage-controls, .controls-idle .volume-row, .controls-idle .stage-caption, .controls-idle .stage-clock { opacity:0; pointer-events:none; }
.hide-guidance .stage-caption, .hide-clock .stage-clock { display:none; }
#guided-display-status:empty { display:none; }
@media(max-width:700px) { .preview-stage:not(:fullscreen) { aspect-ratio:auto!important; height:520px; background:#000; } .preview-stage:not(:fullscreen) .preview-scene { top:100px; bottom:auto; height:auto; aspect-ratio:16/9; } .stage-clock { top:5rem; right:1rem; } .stage-controls { bottom:4.5rem; } .stage-caption, :global(body.temple-session-active) .stage-caption { bottom:8.5rem; } .immersive-toolbar { right:1rem; } }
@media(prefers-reduced-motion:reduce) { .immersive-toolbar, .stage-controls, .volume-row, .stage-caption, .stage-clock { transition:none; } }
</style>
