.podcast-preview{grid-column:2;grid-row:1 / span 2;position:sticky;top:16px;align-self:start;height:fit-content;max-height:calc(100dvh - 32px);overflow-y:auto;background:#07101cf5;border:1px solid #223247;border-radius:16px;padding:16px;box-sizing:border-box;scrollbar-gutter:stable}
