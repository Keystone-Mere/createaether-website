---
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Underwater Sanctuary" description="Settle into a quiet underwater room with gently swimming fish." privacyMode>
<section class="sanctuary">
 <a href="/studio/guided-relaxation/">← Guided relaxation</a>
 <p class="eyebrow">AETHER / UNDERWATER SANCTUARY</p>
 <h1>A quiet moment beneath the water</h1>
 <p>Let your gaze rest on the water. When you begin, your chosen creatures gradually swim into view. Stay as long as you like.</p>
 <fieldset class="creature-controls">
  <legend>Choose who shares your sanctuary</legend>
  <label>Creature <select id="sanctuary-species"><option value="school">Small schooling fish</option><option value="shark">Dark shark silhouette</option><option value="ray">Gliding ray</option></select></label>
  <label>Number <input id="sanctuary-count" type="range" min="1" max="16" value="8" /><output id="sanctuary-count-value">8</output></label>
  <label>Movement speed <input id="sanctuary-speed" type="range" min="25" max="150" step="5" value="100" /><output id="sanctuary-speed-value">100%</output></label>
  <p id="creature-description">Small fish travel together in a loose group.</p>
 </fieldset>
 <div class="stage" id="sanctuary-stage">
  <div class="scene">
   <img src="/images/experience-covers/underwater-sanctuary.png" alt="Warm wooden meditation room overlooking a vast underwater window" width="664" height="441" />
   <canvas id="sanctuary-fish" aria-hidden="true"></canvas>
  </div>
  <div class="toolbar"><button id="sanctuary-toggle" type="button">Begin meditation</button><button id="sanctuary-fullscreen" type="button">Full screen</button></div>
 </div>
 <p id="sanctuary-status" role="status">Silent session · No time limit</p>
 <label><input id="sanctuary-motion" type="checkbox" /> Keep the scene still</label>
 <p class="note">You can watch the fish or close your eyes. There is nothing to follow or complete.</p>
</section>
</StudioLayout>
<script>
 import { UnderwaterFish } from '../../lib/visuals/UnderwaterFish.js';
 const canvas = document.querySelector<HTMLCanvasElement>('#sanctuary-fish');
 const stage = document.querySelector<HTMLElement>('#sanctuary-stage');
 const toggle = document.querySelector<HTMLButtonElement>('#sanctuary-toggle');
 const fullscreen = document.querySelector<HTMLButtonElement>('#sanctuary-fullscreen');
 const motion = document.querySelector<HTMLInputElement>('#sanctuary-motion');
 const status = document.querySelector<HTMLElement>('#sanctuary-status');
 if (canvas && stage && toggle && fullscreen && motion && status) {
  const species = document.querySelector<HTMLSelectElement>('#sanctuary-species')!;
  const count = document.querySelector<HTMLInputElement>('#sanctuary-count')!;
  const speed = document.querySelector<HTMLInputElement>('#sanctuary-speed')!;
  const countValue = document.querySelector<HTMLOutputElement>('#sanctuary-count-value')!;
  const speedValue = document.querySelector<HTMLOutputElement>('#sanctuary-speed-value')!;
  const description = document.querySelector<HTMLElement>('#creature-description')!;
  const limits = { school: 16, shark: 3, ray: 4 };
  const descriptions = {
   school: 'Small fish travel together in a loose group.',
   shark: 'A dark silhouette makes slow passes and turns beyond the window.',
   ray: 'A ray glides through the water with gently moving wings.',
  };
  const key = 'aether-underwater-sanctuary-v2';
  let settings = { species: 'school', count: 8, speed: 100 };
  try {
   const saved = JSON.parse(localStorage.getItem(key) || 'null');
   if (saved && ['school', 'shark', 'ray'].includes(saved.species)) {
    settings = { species: saved.species, count: Number.isFinite(saved.count) ? Math.round(saved.count) : 8, speed: Number.isFinite(saved.speed) ? saved.speed : 100 };
   }
  } catch { /* A blocked storage area still permits an unsaved session. */ }
  species.value = settings.species;
  count.value = String(Math.max(1, Math.min(limits[species.value as keyof typeof limits], settings.count)));
  speed.value = String(Math.max(25, Math.min(150, settings.speed)));
  const updateLabels = () => {
   count.max = String(limits[species.value as keyof typeof limits]);
   countValue.value = count.value;
   speedValue.value = speed.value + '%';
   description.textContent = descriptions[species.value as keyof typeof descriptions];
  };
  updateLabels();
  let fish = new UnderwaterFish(canvas, Number(count.value), species.value, Number(speed.value) / 100);
  const events = new AbortController();
  const options = { signal: events.signal };
  let active = false;
  motion.checked = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sync = () => {
   if (active && !motion.checked && !document.hidden) fish.start(); else fish.pause();
   toggle.textContent = active ? 'Pause meditation' : 'Begin meditation';
   status.textContent = active ? (motion.checked ? 'Session active · Still scene' : 'Session active · ' + species.options[species.selectedIndex].text) : 'Silent session · No time limit';
  };
  const save = () => {
   try { localStorage.setItem(key, JSON.stringify({ species: species.value, count: Number(count.value), speed: Number(speed.value) })); }
   catch { status.textContent += ' · Preferences could not be saved'; }
  };
  const rebuild = () => {
   fish.destroy();
   fish = new UnderwaterFish(canvas, Number(count.value), species.value, Number(speed.value) / 100);
   updateLabels(); sync(); save();
  };
  species.addEventListener('change', () => {
   count.value = species.value === 'school' ? '8' : '1';
   rebuild();
  }, options);
  count.addEventListener('input', () => { updateLabels(); }, options);
  count.addEventListener('change', rebuild, options);
  speed.addEventListener('input', () => {
   fish.speedMultiplier = Number(speed.value) / 100;
   updateLabels(); save();
  }, options);
  toggle.addEventListener('click' , () => { active = !active; sync(); }, options);
  motion.addEventListener('change', sync, options);
  document.addEventListener('visibilitychange', sync, options);
  fullscreen.addEventListener('click', async () => {
   try {
    if (document.fullscreenElement === stage) await document.exitFullscreen();
    else await stage.requestFullscreen();
   } catch { status.textContent = 'Full screen is unavailable in this browser. You can continue here.'; }
  }, options);
  document.addEventListener('fullscreenchange', () => {
   fullscreen.textContent = document.fullscreenElement === stage ? 'Exit full screen' : 'Full screen';
  }, options);
  const cleanup = () => { fish.destroy(); events.abort(); };
  document.addEventListener('astro:before-swap', cleanup, { once: true, signal: events.signal });
  window.addEventListener('pagehide', cleanup, { once: true, signal: events.signal });
 }
</script>
<style>
.creature-controls{border:1px solid #334155;border-radius:12px;margin:24px 0;padding:18px;display:flex;gap:20px;flex-wrap:wrap}.creature-controls legend{color:#6ee7b7;padding:0 8px}.creature-controls label{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.creature-controls p{width:100%;margin:0;font-size:14px}select{font:inherit;color:#f8fafc;background:#1e293b;border:1px solid #475569;border-radius:6px;padding:8px}input[type=range]{max-width:140px}output{min-width:40px}.sanctuary{max-width:1100px;margin:auto;padding:24px 0}.sanctuary a{color:#7dd3fc}.eyebrow{color:#7dd3fc;font-size:12px;letter-spacing:.12em;margin-top:28px}h1{font-size:clamp(28px,4vw,44px);line-height:1.15}p{color:#cbd5e1;line-height:1.7}.stage{background:#111e26;border:1px solid #334155;border-radius:16px;overflow:hidden}.scene{position:relative;width:100%;aspect-ratio:664/441}.scene img{display:block;width:100%;height:100%}canvas{position:absolute;left:18.7%;top:27.3%;width:65.5%;height:48.3%;pointer-events:none}.toolbar{display:flex;gap:12px;justify-content:center;padding:14px;flex-wrap:wrap}button{font:inherit;padding:10px 18px;border:1px solid #475569;border-radius:8px;background:#1e293b;color:#f8fafc;cursor:pointer}#sanctuary-toggle{background:#047857;border-color:#059669}button:focus-visible{outline:3px solid #7dd3fc;outline-offset:3px}.note{font-size:14px}.stage:fullscreen{width:100%;height:100%;border:0;border-radius:0;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#050a0e}.stage:fullscreen .scene{width:min(100vw,calc((100vh - 80px)*664/441));flex-shrink:0}.stage:fullscreen .toolbar{flex-shrink:0}
</style>
