---
import SceneStage from '../../../components/studio/SceneStage.astro';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import AudioPanel from '../../../components/studio/AudioPanel.astro';
import ParticlesPanel from '../../../components/studio/ParticlesPanel.astro';
import VisualLayerPanel from '../../../components/studio/VisualLayerPanel.astro';
import { experiences } from '../../../data/experiences';
import {
    audioTracks,
    defaultAudioTrack
} from '../../../data/audio/tracks';
import ExperienceSwitcher from '../../../components/studio/ExperienceSwitcher.astro';
export function getStaticPaths() {
    return experiences.map((experience) => ({
        params: {
            id: experience.id,
        },
        props: {
            experience,
        },
    }));
}

const { experience } = Astro.props;

const selectedAudioTrack =
    audioTracks.find(
        (track) => track.id === experience.audio.track
    ) ?? defaultAudioTrack;
---

<StudioLayout title={`${experience.name} Experience`} privacyMode={experience.id === 'temple'}>

<section class="editor">

    <header class="hero">
        <div><h1>Aether Studio</h1><p>Shape your experience with sound, colour and atmosphere</p></div>
        <ExperienceSwitcher experiences={experiences} activeExperience={experience.id} />
        <span id="experience-editor-title" hidden>{experience.name}</span>
        <span id="experience-editor-status" hidden>{experience.status}</span>
    </header>
    <aside class="first-creation-hint" id="first-creation-hint" aria-labelledby="first-creation-title" hidden>
        <div><h2 id="first-creation-title">Make this atmosphere yours.</h2>
        <p>Change a colour, adjust the sound, then choose <strong>Save as Copy</strong> to keep your version on this device.</p></div>
        <button type="button" id="dismiss-first-creation-hint" aria-label="Dismiss getting started hint">Got it</button>
    </aside>
    <div class="grid">
        <div class="editor-controls editor-column">
            <details class="control-section" open>
                <summary>Audio</summary>
                <div class="audio-slot"><AudioPanel experience={experience} /></div>
            </details>
            <details class="control-section" open>
                <summary><span id="effect-section-label">Visual effects</span></summary>
                <div class="particles-slot"><ParticlesPanel experience={experience} /></div>
            </details>
            <details class="control-section">
                <summary>Lighting</summary>
                <div class="lighting-slot"><VisualLayerPanel layer="lighting" experience={experience} /></div>
            </details>
            <details class="control-section">
                <summary>Fog</summary>
                <div class="fog-slot"><VisualLayerPanel layer="fog" experience={experience} /></div>
            </details>
            <details class="control-section">
                <summary>Background</summary>
                <div class="environment-slot"><VisualLayerPanel layer="environment" experience={experience} /></div>
            </details>
        </div>
        <div class="editor-output editor-column">
        <div class="panel preview-panel">
            <div class="preview-header">
                <div>
                    <p class="panel-label">Runtime preview</p>
                    <h2>Live Preview</h2>
                </div>

                <span
                    id="preview-runtime-status"
                    class="preview-status">
                    <span
                        id="preview-runtime-status-dot"
                        class="preview-status__dot"
                    ></span>
                    Ready
                </span>
            </div>

            <SceneStage sceneId={experience.id} name={experience.name} />
            <div class="preview-stage__label">
                <span id="preview-experience-name">{experience.name} Environment</span>
                <small id="preview-experience-description">{experience.description}</small>
            </div>

            <div class="preview-actions">
                <button type="button" id="choose-background" class="button-secondary">Upload background</button>
                <input id="background-upload" type="file" accept="image/jpeg,image/png,image/webp" hidden />
                <button type="button" id="reset-background" class="button-secondary">Use original background</button>
            </div>
            <p id="background-feedback" role="status" class="save-feedback">JPG, PNG or WebP, up to 15 MB. Images fill the scene and may be cropped.</p>
            <div class="preview-actions">
                <button type="button" id="audio-playback-toggle" aria-pressed="false">Play Audio</button>
                <button type="button" id="launch-preview-button" class="button-secondary" aria-controls="experience-preview-stage">Full-screen Preview</button>
            </div>
            <span id="audio-track-title" hidden>{selectedAudioTrack.title}</span>
            <span id="audio-playback-status" role="status" class="transport-status">Ready to play</span>
            <div class="preview-features" hidden>
                <span id="audio-status">Audio enabled</span><span id="particles-status">Particles active</span>
                <span id="lighting-status">Lighting active</span><span id="fog-status">Fog active</span>
            </div>
        </div>
        <div class="panel save-panel">
            <h2>Save and Use Elsewhere</h2>
            <label for="creation-name">Name your creation</label>
            <input id="creation-name" type="text" maxlength="120" placeholder="For example, Storm podcast backdrop" style="width:100%;box-sizing:border-box;margin:8px 0 12px;padding:12px;border:1px solid #475569;border-radius:8px;background:#192537;color:#f8fafc" />
            <small>Your saved creation appears in My Experiences at the top of the dashboard.</small>
            <p>Save your creation or use it as a silent animated backdrop in OBS. Export again after changing its settings.</p>
            <div class="preview-actions">
                <button type="button" id="save-experience-button">Save as Copy</button>
                <button type="button" id="use-in-obs" class="button-secondary" aria-controls="obs-setup">Use in OBS</button>
                <button type="button" id="import-experience-button" class="button-secondary">Import experience</button>
            </div>
            <div id="obs-setup" hidden>
                <h3>Set up your OBS backdrop</h3>
                <p id="obs-setup-instructions" role="status" aria-live="polite"></p>
                <label for="obs-playback-url" id="obs-playback-label" hidden>Playback URL — select and copy this link</label>
                <input id="obs-playback-url" type="text" readonly hidden style="width:100%;box-sizing:border-box;padding:12px;background:#192537;color:#f8fafc;border:1px solid #475569;border-radius:8px" />
                <p id="obs-host-warning" hidden>This export uses your local development server. Keep it running, or export from createaether.com for use without that server.</p>
                <small>Sound is off. Export again after changes. An internet connection is required for exports from the live website.</small>
            </div>
            <p id="save-experience-feedback" class="save-feedback" role="status" aria-live="polite"></p>
            <a id="saved-experiences-link" class="saved-experiences-link" href="/studio/#my-experiences-title" hidden>View My Experiences →</a>
            <input type="file" id="import-experience-input" accept=".aether.json,.json,application/json" hidden />
            <span id="import-experience-status" role="status"></span>
        </div>
        </div>

    </div>

</section>

<script>
    const hint = document.querySelector<HTMLElement>('#first-creation-hint');
    const dismiss = document.querySelector<HTMLButtonElement>('#dismiss-first-creation-hint');
    const hintKey = 'aether-studio-first-creation-seen-v1';
    if (hint) {
        try {
            if (!localStorage.getItem(hintKey)) {
                hint.hidden = false;
                localStorage.setItem(hintKey, 'true');
            }
        } catch { hint.hidden = false; }
        dismiss?.addEventListener('click', () => { hint.hidden = true; });
    }
</script>
<style>
.first-creation-hint { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 22px; margin-bottom:24px; border:1px solid #38bdf844; border-radius:14px; background:#102238; }
.first-creation-hint[hidden], .saved-experiences-link[hidden] { display:none; }
.first-creation-hint h2 { font-size:16px; margin:0 0 6px; }
.first-creation-hint p { font-size:13px; line-height:1.65; color:#bdd0e5; margin:0; }
.first-creation-hint button { flex-shrink:0; padding:9px 14px; border:1px solid #7dd3fc55; border-radius:8px; color:#e0f2fe; background:#193d5a; cursor:pointer; }
.first-creation-hint button:focus-visible, .saved-experiences-link:focus-visible { outline:2px solid #7dd3fc; outline-offset:3px; }
.save-feedback { font-size:13px; line-height:1.6; color:#bdd0e5; }
.save-feedback:empty { display:none; }
.editor #save-experience-button { background:#15803d; border:1px solid #22c55e; color:#fff; font-weight:700; }
.editor #save-experience-button:hover:not(:disabled) { background:#166534; }
.editor #save-experience-button:focus-visible { outline:3px solid #86efac; outline-offset:3px; }
.editor #save-experience-button:disabled { opacity:.65; cursor:wait; }
.saved-experiences-link { display:inline-block; margin-bottom:12px; font-size:13px; color:#7dd3fc; }
@media(max-width:600px) { .first-creation-hint { align-items:flex-start; flex-direction:column; padding:16px; } }

.editor{
    padding:2rem;
}

.hero{
    margin-bottom:2rem;
}

.hero p{
    color:#38bdf8;
    text-transform:uppercase;
    letter-spacing:.1em;
    font-size:.8rem;
}

.hero h1{
    margin:.25rem 0;
}

.hero span{
    color:#22c55e;
    font-weight:600;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
    gap:1.5rem;
}

.panel{
    background:#10182c;
    border:1px solid rgba(255,255,255,.08);
    border-radius:18px;
    padding:1.5rem;
}

.panel h2{
    margin-top:0;
}

.panel label{
    display:block;
    margin-top:1rem;
    margin-bottom:.5rem;
}

.panel input,
.panel textarea{
    width:100%;
    background:#172036;
    border:1px solid rgba(255,255,255,.08);
    color:white;
    border-radius:8px;
    padding:.75rem;
    box-sizing:border-box;
}

.panel button{
    margin-right:.5rem;
    margin-top:.75rem;
    padding:.7rem 1.1rem;
    border:none;
    border-radius:10px;
    background:#2563eb;
    color:white;
    cursor:pointer;
}

.preview-panel{
    overflow:hidden;
}

.preview-header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:1rem;
    margin-bottom:1.25rem;
}

.preview-header h2{
    margin:.25rem 0 0;
}

.panel-label{
    margin:0;
    color:#38bdf8;
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.12em;
    text-transform:uppercase;
}

.preview-status{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    padding:.45rem .7rem;
    border:1px solid rgba(52,211,153,.25);
    border-radius:999px;
    background:rgba(16,185,129,.08);
    color:#6ee7b7;
    font-size:.75rem;
    font-weight:700;
}


.preview-status__dot--loading{
    background:#f59e0b;
    box-shadow:
        0 0 16px rgba(245,158,11,.9);
    animation:
        preview-status-pulse
        1s ease-in-out infinite;
}

@keyframes preview-status-pulse{

    0%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.35);
    }

    100%{
        transform:scale(1);
    }

}

.preview-status__dot{
    width:.5rem;
    height:.5rem;
    border-radius:50%;
    background:#34d399;
    box-shadow:0 0 12px rgba(52,211,153,.9);
}

.preview-stage{
    --aether-lighting-colour:#3b82f6;
    --aether-stage-ambient:#3b82f6;
    --aether-environment-colour:#0b1427;
    --aether-lighting-intensity:1;
    --aether-lighting-glow-strength:18%;
    --aether-lighting-orb-strength:55%;
    --aether-lighting-shadow-strength:42%;
    --aether-lighting-pulse-duration:4s;

    --aether-fog-colour:#94a3b8;
    --aether-fog-opacity:.35;
    --aether-fog-secondary-opacity:.2;
    --aether-fog-blur:20px;
    --aether-fog-duration:14s;

    --aether-transition-duration:1000ms;
    --aether-transition-easing:ease;

    position:relative;
    min-height:240px;
    overflow:hidden;
    border:1px solid rgba(56,189,248,.18);
    border-radius:14px;
    background:
        radial-gradient(
            circle at 50% 48%,
            color-mix(
                in srgb,
                var(--aether-stage-ambient) 16%,
                transparent
            ),
            transparent 34%
        ),
        linear-gradient(
            180deg,
            color-mix(in srgb, var(--aether-environment-colour) 72%, #020617) 0%,
            var(--aether-environment-colour) 58%,
            color-mix(in srgb, var(--aether-environment-colour) 70%, #1e293b) 100%
        );
}

.preview-canvas{
    position:absolute;
    z-index:3;
    inset:0;
    width:100%;
    height:100%;
    pointer-events:none;
}

.preview-glow{
    position:absolute;
    left:50%;
    top:48%;
    width:180px;
    height:180px;
    border-radius:50%;
    background:color-mix(
        in srgb,
        var(--aether-lighting-colour)
        var(--aether-lighting-glow-strength),
        transparent
    );
    filter:blur(28px);
    transform:translate(-50%,-50%);
    animation:
        preview-pulse
        var(--aether-lighting-pulse-duration)
        ease-in-out
        infinite;
}

.preview-orb{
    position:absolute;
    z-index:2;
    left:50%;
    top:45%;
    width:74px;
    height:74px;
    border:1px solid color-mix(
        in srgb,
        var(--aether-lighting-colour) 65%,
        white
    );
    border-radius:50%;
    background:
        radial-gradient(
            circle at 38% 32%,
            rgba(255,255,255,.94),
            color-mix(
                in srgb,
                var(--aether-lighting-colour)
                var(--aether-lighting-orb-strength),
                white
            ) 18%,
            color-mix(
                in srgb,
                var(--aether-lighting-colour) 30%,
                transparent
            ) 50%,
            rgba(15,23,42,.1) 74%
        );
    box-shadow:
        0 0 24px color-mix(
            in srgb,
            var(--aether-lighting-colour)
            var(--aether-lighting-shadow-strength),
            transparent
        ),
        0 0 70px color-mix(
            in srgb,
            var(--aether-lighting-colour) 24%,
            transparent
        );
    transform:translate(-50%,-50%);
    animation:preview-float 5s ease-in-out infinite;
}

.preview-stage--lighting-static .preview-glow{
    animation:none;
}

.preview-stage--lighting-disabled .preview-glow{
    display:none;
}

.preview-stage--lighting-disabled .preview-orb{
    background:#172033;
    border-color:rgba(148,163,184,.25);
    box-shadow:none;
}

.preview-stage--fog-disabled .preview-fog{
    opacity:0;
}

.preview-fog{
    position:absolute;
    left:-15%;
    z-index:1;
    width:130%;
    height:82px;
    border-radius:50%;
    background:
        radial-gradient(
            ellipse at center,
            color-mix(
                in srgb,
                var(--aether-fog-colour) 65%,
                transparent
            ) 0%,
            color-mix(
                in srgb,
                var(--aether-fog-colour) 32%,
                transparent
            ) 48%,
            transparent 78%
        );
    filter:blur(var(--aether-fog-blur));
    opacity:var(--aether-fog-opacity);
    pointer-events:none;
    will-change:transform,opacity;
}

.preview-fog--one{
    bottom:15px;
    animation:
        fog-drift
        var(--aether-fog-duration)
        ease-in-out
        infinite;
}

.preview-fog--two{
    bottom:48px;
    opacity:var(--aether-fog-secondary-opacity);
    animation:
        fog-drift
        calc(var(--aether-fog-duration) * 1.3)
        ease-in-out
        infinite
        reverse;
}

.preview-stage__label{
    position:absolute;
    z-index:4;
    left:1rem;
    right:1rem;
    bottom:1rem;
    display:flex;
    flex-direction:column;
    gap:.2rem;
}

.preview-stage__label span{
    color:#f8fafc;
    font-size:.8rem;
    font-weight:700;
}

.preview-stage__label small{
    color:#7c93b6;
    font-size:.7rem;
}

.preview-features{
    display:flex;
    flex-wrap:wrap;
    gap:.5rem;
    margin-top:1rem;
}

.preview-features span{
    padding:.4rem .65rem;
    border:1px solid rgba(148,163,184,.14);
    border-radius:999px;
    background:rgba(15,23,42,.6);
    color:#9fb4d4;
    font-size:.7rem;
}

.preview-actions{
    display:flex;
    flex-wrap:wrap;
    gap:.55rem;
    margin-top:1rem;
}

.preview-actions button{
    margin:0;
}

.preview-actions .button-secondary{
    border:1px solid rgba(56,189,248,.32);
    background:rgba(14,116,144,.12);
    color:#7dd3fc;
}

.preview-actions .button-secondary:hover{
    background:rgba(14,116,144,.24);
}

.preview-actions .button-muted{
    border:1px solid rgba(148,163,184,.18);
    background:rgba(51,65,85,.35);
    color:#94a3b8;
    cursor:not-allowed;
    opacity:0.9;
}

.preview-actions .button-muted:hover{
    background:rgba(51,65,85,.35);
}

@keyframes preview-float{
    0%,
    100%{
        transform:translate(-50%,-50%);
    }

    50%{
        transform:translate(-50%,-58%);
    }
}

@keyframes preview-pulse{
    0%,
    100%{
        opacity:.55;
        transform:translate(-50%,-50%) scale(.9);
    }

    50%{
        opacity:1;
        transform:translate(-50%,-50%) scale(1.15);
    }
}

@keyframes fog-drift{
    0%,
    100%{
        transform:translateX(-3%);
    }

    50%{
        transform:translateX(3%);
    }
}

@media (prefers-reduced-motion: reduce){
    .preview-glow,
    .preview-orb,
    .preview-fog{
        animation:none;
    }
}


.volume-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    margin-top:1rem;
    margin-bottom:.5rem;
}

.volume-heading label{
    margin:0;
}

.volume-heading output{
    color:#7dd3fc;
    font-size:.82rem;
    font-weight:700;
}

.audio-transport{
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:1rem;
    margin-top:1.25rem;
    padding:1rem;
    border:1px solid rgba(125,211,252,.18);
    border-radius:14px;
    background:rgba(15,23,42,.55);
}

.audio-transport > div{
    flex:1 1 14rem;
    min-width:0;
}

.audio-transport h3{
    margin:.15rem 0;
    font-size:1rem;
    line-height:1.35;
    word-break:break-word;
}

.audio-transport span{
    color:#94a3b8;
    font-size:.82rem;
}

.audio-transport button{
    flex:0 0 auto;
    min-width:10.5rem;
    max-width:100%;
}

@media (max-width:640px){
    .audio-transport{
        align-items:stretch;
        flex-direction:column;
    }

    .audio-transport > div,
    .audio-transport button{
        width:100%;
        flex-basis:100%;
    }

    .audio-transport button{
        justify-content:center;
    }
}


.editor { padding: 0; max-width: 1600px; margin: 0 auto; }
.hero { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:24px; }
.hero h1 { margin:0 0 12px; font-size:28px; color:white; }
.hero p { margin:0; max-width:550px; color:#cbd5e1; text-transform:none; letter-spacing:normal; font-size:14px; line-height:1.5; }
 .grid {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:start;gap:24px;}
.editor-controls, .editor-feedback {display:contents;}
.editor-column {display:flex;flex-direction:column;gap:24px;min-width:0;}
.editor-primary {grid-column:1;grid-row:1;}
.editor-particles {grid-column:2;grid-row:1;}
.editor-layers {grid-column:3;grid-row:1;}
.editor-output {grid-column:4;grid-row:1;}
.journey-slot {grid-column:1/-1;min-width:0;}
.grid > * {min-width:0;}
.panel {padding:20px; background:#101827; border:0; border-radius:18px;}
.panel h2 {color:#93c5fd; font-size:22px; margin:0 0 24px;}
.panel-label {display:none;}
.preview-header h2 {margin:0;}
.preview-header {align-items:center;}
.preview-status {font-size:11px; padding:4px 6px;}
.preview-actions {display:flex; flex-wrap:wrap; gap:8px; margin-top:20px;}
.panel button {margin:0; min-height:44px; padding:10px 14px; font-size:13px; border-radius:8px;}
.button-secondary {background:#192537 !important; border:1px solid #475569 !important;}
.fullscreen-exit {display:none;}
.preview-stage:fullscreen {width:100vw;height:100vh;min-height:0;max-height:none;aspect-ratio:auto;border:0;border-radius:0;}
.preview-stage:fullscreen .fullscreen-exit {display:block;position:absolute;right:24px;top:24px;z-index:10;background:#192537;border:1px solid #94a3b8;color:white;}
.preview-stage:fullscreen .preview-orb {width:clamp(74px,15vmin,180px);height:clamp(74px,15vmin,180px);}
.preview-stage:fullscreen .preview-glow {width:40vmin;height:40vmin;}
.preview-stage:fullscreen .preview-stage__label {left:24px;right:24px;bottom:24px;}
.preview-stage:not(:fullscreen) {height:auto; min-height:220px; aspect-ratio:1.43;}
.preview-stage__label {left:16px; right:16px; bottom:16px;}
.preview-stage__label small {white-space:normal; line-height:1.4;}
.transport-status {display:block; color:#94a3b8; font-size:12px; margin-top:12px;}
.preview-features[hidden] {display:none;}
.save-panel p {font-size:14px; line-height:1.5; color:#cbd5e1;}
@media(max-width:1450px) {
.grid {grid-template-columns:repeat(2,minmax(0,1fr));}
.editor-controls,.editor-feedback {display:flex;flex-direction:column;gap:24px;min-width:0;}
.editor-controls {grid-column:1;grid-row:1;}
.editor-feedback {grid-column:2;grid-row:1;}
.editor-output {order:0;}
.editor-particles {order:1;}
}
@media(max-width:700px) {
.hero {display:flex;flex-direction:column;align-items:stretch;gap:24px;}
.grid {display:flex;flex-direction:column;}
.grid > * {width:100%;}
.editor-particles {order:0;}
.editor-output {order:1;}
.hero h1 {font-size:24px;}
}

.preview-scene { position:absolute; inset:0; overflow:hidden; }
.preview-scene-image, .scene-tint, .candle-light { display:none; pointer-events:none; }
.preview-stage .preview-scene-image { display:block; position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.preview-stage[data-scene="temple"] .preview-glow,
.preview-stage[data-scene="temple"] .preview-orb { display:none; }
.preview-stage .scene-tint { display:block; position:absolute; inset:0; background:var(--aether-environment-colour); opacity:.08; z-index:1; }
.preview-stage[data-scene="temple"] .candle-light { display:block; position:absolute; width:20%; height:32%; transform:translate(-50%,-50%); z-index:2; background:radial-gradient(ellipse, color-mix(in srgb,var(--aether-lighting-colour) 85%,transparent),transparent 70%); mix-blend-mode:screen; opacity:calc(var(--aether-lighting-intensity) * .6); animation:candle-shimmer var(--aether-lighting-pulse-duration, 4.7s) ease-in-out infinite alternate; }
.candle-light--left { left:10%; top:32%; }
.candle-light--back { left:44%; top:33%; animation-delay:-1.7s!important; }
.candle-light--right { left:86%; top:41%; animation-delay:-2.8s!important; }
.candle-light--front { left:7%; top:73%; animation-delay:-3.6s!important; }
.preview-stage[data-scene="temple"].preview-stage--lighting-disabled .candle-light { display:none; }
.preview-stage--lighting-static .candle-light { animation:none!important; }
.preview-stage:not(:fullscreen) { min-height:0; aspect-ratio:16/9; }
.preview-stage:fullscreen { background:#000; display:grid; place-items:center; }
.preview-stage:fullscreen .preview-scene { position:relative; inset:auto; width:min(100vw,177.7778vh); height:min(100vh,56.25vw); }
.scene-light { position:absolute; inset:0; pointer-events:none; z-index:2; background:radial-gradient(ellipse at 65% 20%,var(--aether-lighting-colour),transparent 70%); mix-blend-mode:screen; opacity:calc(var(--aether-lighting-intensity) * .18); animation:scene-breathe var(--aether-lighting-pulse-duration) ease-in-out infinite alternate; }
.preview-stage[data-scene="temple"] .scene-light { display:none; }
.preview-stage[data-scene="ocean"] .scene-light { background:linear-gradient(180deg,transparent 35%,var(--aether-lighting-colour) 55%,transparent 75%); }
.preview-stage[data-scene="christmas"] .scene-light { background:radial-gradient(ellipse at 78% 65%,var(--aether-lighting-colour),transparent 65%); }
.preview-stage[data-scene="festival"] .scene-light { background:radial-gradient(ellipse at 35% 35%,var(--aether-lighting-colour),transparent 55%),radial-gradient(ellipse at 70% 35%,var(--aether-lighting-colour),transparent 55%); }
.preview-stage[data-scene="storm"] .preview-fog {
    left:0; top:0; bottom:auto; width:100%; height:100%; border-radius:0;
    clip-path:polygon(0% 8%,23% 0%,100% 0%,100% 100%,69% 100%,0% 86%);
    background:radial-gradient(ellipse at 65% 65%,color-mix(in srgb,var(--aether-fog-colour) 35%,transparent),transparent 65%);
    animation:none;
}
.preview-stage[data-scene="storm"] .scene-light { background:radial-gradient(ellipse at 0% 100%,var(--aether-lighting-colour),transparent 30%); }

/* Stage haze remains above the audience in scene-relative coordinates. */
.preview-stage[data-scene="festival"] .preview-fog {
    z-index:2; left:18%; width:53%; height:24%; bottom:auto;
    border-radius:45%; filter:blur(12px);
    mix-blend-mode:screen;
    background:radial-gradient(ellipse at 35% 55%,color-mix(in srgb,var(--aether-fog-colour) 80%,transparent),transparent 55%),radial-gradient(ellipse at 70% 45%,color-mix(in srgb,var(--aether-lighting-colour) 50%,transparent),transparent 60%);
    animation-name:festival-haze-drift;
    animation-duration:calc(var(--aether-fog-duration) * 2);
}
.preview-stage[data-scene="festival"] .preview-fog--one { top:41%; }
.preview-stage[data-scene="festival"] .preview-fog--two { top:47%; height:18%; animation-duration:calc(var(--aether-fog-duration) * 2.6); }
.preview-stage[data-scene="festival"].preview-stage--fog-disabled .preview-fog { opacity:0; }
.preview-stage[data-scene="festival"] .scene-light { animation-duration:calc(var(--aether-lighting-pulse-duration) * 2.5); }
@keyframes festival-haze-drift {
    0%,100% { transform:translate(-4%,0) scale(1); }
    50% { transform:translate(4%,-4%) scale(1.05); }
}
@media(prefers-reduced-motion:reduce) { .preview-stage[data-scene="festival"] .preview-fog { animation:none; } }

.preview-stage--lighting-disabled .scene-light { display:none; }
.preview-stage--lighting-static .scene-light { animation:none; }
@keyframes scene-breathe { to { opacity:calc(var(--aether-lighting-intensity) * .3); } }
@media(prefers-reduced-motion:reduce) { .scene-light { animation:none!important; } }
.preview-stage__label { position:static!important; margin-top:12px; }
@keyframes candle-shimmer { 0% { opacity:calc(var(--aether-lighting-intensity) * .25); } 38% { opacity:calc(var(--aether-lighting-intensity) * .95); } 71% { opacity:calc(var(--aether-lighting-intensity) * .4); } 100% { opacity:calc(var(--aether-lighting-intensity) * .8); } }
@media (prefers-reduced-motion:reduce) { .candle-light { animation:none!important; } }


/* One settings column leaves most of the workspace for the scene. */
.grid {display:grid;grid-template-columns:minmax(260px,320px) minmax(0,1fr);gap:24px;align-items:start;}
.editor-controls {display:flex;grid-column:1;grid-row:1;flex-direction:column;gap:16px;min-width:0;}
.editor-output {grid-column:2;grid-row:1;position:sticky;top:16px;align-self:start;min-width:0;}
.control-section {background:#101827;border-radius:18px;overflow:hidden;}
.control-section > summary {padding:20px;color:#93c5fd;font-size:20px;font-weight:700;cursor:pointer;}
.control-section > summary:focus-visible {outline:2px solid #7dd3fc;outline-offset:-4px;}
.control-section[open] > summary {padding-bottom:4px;}
@media(max-width:900px) {
 .editor {padding:1rem;}
 .grid {grid-template-columns:minmax(240px,.85fr) minmax(0,1.3fr);gap:16px;}
}
@media(max-width:700px) {
 .grid {display:flex;flex-direction:column;}
 .editor-output {order:0;position:static;width:100%;}
 .editor-controls {order:1;width:100%;}
}

</style>

<style is:global>
.editor .panel {background:#101827;border:0;border-radius:18px;padding:20px;}
.editor .control-section .panel > h2 {display:none;}
.editor .panel h2 {color:#93c5fd;font-size:22px;margin:0 0 24px;}
.editor .panel label {font-size:14px;font-weight:600;}
.editor .panel input:not([type=checkbox]):not([type=range]):not([type=color]), .editor .panel textarea {background:#192537;border:1px solid #475569;color:white;padding:10px 12px;border-radius:8px;width:100%;}
.editor .panel select {width:100%;min-height:44px;padding:10px 12px;background:#192537;border:1px solid #475569;border-radius:8px;color:white;text-transform:capitalize;}
.editor .panel input[type=range] {width:100%;accent-color:#93c5fd;padding:0;min-height:24px;}
.editor .panel input[type=checkbox] {accent-color:#38bdf8;width:16px;height:16px;margin:0;}
.editor .panel label.toggle-row {display:flex;justify-content:flex-start;gap:8px;align-items:center;margin:0 0 24px;}
.editor .particles-slot .panel > label:not(.toggle-row) {display:flex;justify-content:space-between;align-items:center;gap:12px;}
.editor .colour-picker {display:flex;align-items:center;gap:12px;background:#192537;border:1px solid #475569;border-radius:8px;padding:6px 10px;width:fit-content;max-width:100%;}
.editor .colour-picker input[type=color] {width:32px;height:32px;border:0;background:none;padding:0;cursor:pointer;}
.editor .colour-picker output {font-size:13px;color:#cbd5e1;}
.editor .panel > label:not(.toggle-row) {display:block;margin-top:20px;margin-bottom:8px;}
.editor output {color:#38bdf8;}
.editor .range-pair {grid-template-columns:1fr;gap:14px;}
.editor .range-pair > div {display:grid;grid-template-columns:1fr auto;align-items:center;}
.editor .range-pair input {grid-column:1/-1;}
.editor .range-pair span {font-size:14px;color:#cbd5e1;margin:0;font-weight:600;}
.editor .range-pair output {margin:0;}
.editor .particle-heading {color:#93c5fd;font-size:16px;margin:24px 0 16px;}
.editor .preset-name {display:block;padding:10px 12px;background:#192537;border:1px solid #475569;border-radius:8px;text-transform:capitalize;font-size:14px;}
</style>
<script
    id="experience-configuration"
    type="application/json"
    set:html={JSON.stringify(experience)}
></script>

<script
    id="experience-library"
    type="application/json"
    set:html={JSON.stringify(experiences)}
></script>

<audio
    id="experience-audio"
    src={selectedAudioTrack.src}
    data-track-id={experience.audio.track}
    preload="metadata"
    loop={selectedAudioTrack.loop}
    hidden
></audio>

<script>
    import { prepareBackground, createBackdropHtml } from '../../../lib/player/Background';
    import { createPlaybackUrl } from '../../../lib/player/PlaybackLink';
    import { audioTracks } from '../../../data/audio/tracks';
    import { experiences as defaultExperiences } from '../../../data/experiences';
    import type {
        Experience,
        ParticleSettings
    } from '../../../lib/models/Experience';
    import {
        createStudioRuntime
    } from '../../../lib/studio/StudioRuntime';
    import {
        isExperience
    } from '../../../lib/storage/ExperienceLibrary';

    const audioEnabledToggle =
        document.querySelector('#audio-enabled');

    const volumeControl = document.querySelector('#volume-control');
    const volumeValue = document.querySelector('#volume-value');
    const layerVolumeControl = document.querySelector('#layer-volume-control');
    const layerVolumeValue = document.querySelector('#layer-volume-value');

    const particlesToggle = document.querySelector('#particles-toggle');
    const lightingToggle = document.querySelector('#lighting-toggle');
    const fogToggle = document.querySelector('#fog-toggle');

    const particleCountControl =
        document.querySelector('#particle-count-control');

    const particleCountValue =
        document.querySelector('#particle-count-value');

    const particleColourControl =
        document.querySelector('#particles-colour-control');

    const environmentColourControl =
        document.querySelector('#environment-colour-control');

    const lightingColourControl =
        document.querySelector('#lighting-colour-control');

    const fogColourControl =
        document.querySelector('#fog-colour-control');

    const particleGlowControl =
        document.querySelector('#particle-glow-control');

    const particleGlowValue =
        document.querySelector('#particle-glow-value');

    const particleDriftControl =
        document.querySelector('#particle-drift-control');

    const particleDriftValue =
        document.querySelector('#particle-drift-value');

    const particleMinRadiusControl =
        document.querySelector('#particle-min-radius-control');

    const particleMinRadiusValue =
        document.querySelector('#particle-min-radius-value');

    const particleMaxRadiusControl =
        document.querySelector('#particle-max-radius-control');

    const particleMaxRadiusValue =
        document.querySelector('#particle-max-radius-value');

    const particleMinSpeedControl =
        document.querySelector('#particle-min-speed-control');

    const particleMinSpeedValue =
        document.querySelector('#particle-min-speed-value');

    const particleMaxSpeedControl =
        document.querySelector('#particle-max-speed-control');

    const particleMaxSpeedValue =
        document.querySelector('#particle-max-speed-value');

    const particleMinOpacityControl =
        document.querySelector('#particle-min-opacity-control');

    const particleMinOpacityValue =
        document.querySelector('#particle-min-opacity-value');

    const particleMaxOpacityControl =
        document.querySelector('#particle-max-opacity-control');

    const particleMaxOpacityValue =
        document.querySelector('#particle-max-opacity-value');

    const particleMinLifetimeControl =
        document.querySelector('#particle-min-lifetime-control');

    const particleMinLifetimeValue =
        document.querySelector('#particle-min-lifetime-value');

    const particleMaxLifetimeControl =
        document.querySelector('#particle-max-lifetime-control');

    const particleMaxLifetimeValue =
        document.querySelector('#particle-max-lifetime-value');

    const previewStage = document.querySelector('.preview-stage');
    const previewCanvas = document.querySelector('.preview-canvas');
    const audioElement = document.querySelector('#experience-audio');

    const experienceConfiguration =
        document.querySelector(
            '#experience-configuration'
        );

    const experienceLibraryConfiguration =
        document.querySelector(
            '#experience-library'
        );

    const experienceCards =
        document.querySelectorAll<HTMLButtonElement>(
            '[data-experience-id]'
        );

    const experienceNameControl =
        document.querySelector('#experience-name');

    const experienceDescriptionControl =
        document.querySelector('#experience-description');

    const experienceEditorTitle =
        document.querySelector('#experience-editor-title');

    const experienceEditorStatus =
        document.querySelector('#experience-editor-status');

    const previewExperienceName =
        document.querySelector('#preview-experience-name');

    const previewExperienceDescription =
        document.querySelector(
            '#preview-experience-description'
        );

    const audioTrackTitle =
        document.querySelector('#audio-track-title');

    const audioPlaybackToggle =
        document.querySelector('#audio-playback-toggle');

    const audioPlaybackStatus =
        document.querySelector('#audio-playback-status');

    const launchPreviewButton =
        document.querySelector('#launch-preview-button');

    const saveExperienceButton =
        document.querySelector('#save-experience-button');

    const importExperienceButton =
        document.querySelector('#import-experience-button');

    const importExperienceInput =
        document.querySelector('#import-experience-input');
    const importExperienceStatus =
        document.querySelector('#import-experience-status');

    const particlesStatus = document.querySelector('#particles-status');
    const lightingStatus = document.querySelector('#lighting-status');
    const fogStatus = document.querySelector('#fog-status');

    const {
        experienceRuntime,
        experienceLibrary,
        experienceState,
        experienceLoader
    } = createStudioRuntime({
        audioElement,
        audioEnabledToggle,
        volumeControl,
        volumeValue,
        layerVolumeControl,
        particlesToggle,
        lightingToggle,
        fogToggle,
        previewStage,
        previewCanvas,
        particlesStatus,
        lightingStatus,
        fogStatus
    });

    let editableExperience: Experience | null = null;

    const canonicalExperienceIds = new Set([
        'temple',
        'forest',
        'ocean',
        'christmas',
        'storm',
        'festival'
    ]);

    const isCanonicalExperience = (
        experience: Experience
    ): boolean => canonicalExperienceIds.has(experience.id);

    const updateSaveButtonLabel = (
        experience: Experience
    ): void => {
        if (saveExperienceButton instanceof HTMLButtonElement) {
            saveExperienceButton.textContent =
                isCanonicalExperience(experience)
                    ? 'Save as Copy'
                    : 'Save Changes';
        }
    };

    const cloneExperience = (
        source: Experience
    ): Experience => ({
        ...source,

        audio: {
            ...source.audio
        },

        atmosphere: {
            ...source.atmosphere
        },

        environment: {
            colour:
                source.environment?.colour
                ?? source.lighting.colour
        },

        lighting: {
            ...source.lighting
        },

        fog: {
            ...source.fog
        },

        particles: {
            ...source.particles
        },

        transition: {
            ...source.transition
        }
    });

    const formatTrackName = (
        trackId: string
    ): string => {
        const titles: Record<string, string> = {
            'temple-echoes': 'Temple Echoes',
            'forest-ambience': 'Forest Wind',
            'ocean-waves': 'Ocean Ambient',
            'christmas-ambient': 'Ambient Christmas',
            'festival': 'Carnival'
        };
        if (titles[trackId]) return titles[trackId];
        return trackId
            .split('-')
            .filter(Boolean)
            .map(
                (word) =>
                    word.charAt(0).toUpperCase()
                    + word.slice(1)
            )
            .join(' ');
    };

    const setInputValue = (
        selector: string,
        value: string | number
    ): void => {
        const control =
            document.querySelector(selector);

        if (control instanceof HTMLInputElement) {
            control.value = String(value);
        }
    };

    const setOutputValue = (
        selector: string,
        value: string | number
    ): void => {
        const output =
            document.querySelector(selector);

        if (output instanceof HTMLOutputElement) {
            output.value = String(value);
            output.textContent = String(value);
        }
    };

    const synchroniseEditor = (
        selectedExperience: Experience
    ): void => {
        updateSaveButtonLabel(selectedExperience);
        const creationName = document.querySelector<HTMLInputElement>('#creation-name');
        if (creationName) creationName.value = isCanonicalExperience(selectedExperience) ? '' : selectedExperience.name;

        if (
            experienceNameControl
            instanceof HTMLInputElement
        ) {
            experienceNameControl.value =
                selectedExperience.name;
        }

        if (
            experienceDescriptionControl
            instanceof HTMLTextAreaElement
        ) {
            experienceDescriptionControl.value =
                selectedExperience.description;
            experienceDescriptionControl.readOnly =
                isCanonicalExperience(selectedExperience);
        }

        if (
            experienceEditorTitle
            instanceof HTMLElement
        ) {
            experienceEditorTitle.textContent =
                selectedExperience.name;
        }

        if (
            experienceEditorStatus
            instanceof HTMLElement
        ) {
            experienceEditorStatus.textContent =
                selectedExperience.status;
        }

        if (
            previewExperienceName
            instanceof HTMLElement
        ) {
            previewExperienceName.textContent =
                `${selectedExperience.name} Environment`;
        }

        if (
            previewExperienceDescription
            instanceof HTMLElement
        ) {
            previewExperienceDescription.textContent =
                selectedExperience.description;
        }

        const experienceSelect = document.querySelector('#experience-selector');
        if (experienceSelect instanceof HTMLSelectElement) {
            if (!Array.from(experienceSelect.options).some(option => option.value === selectedExperience.id)) {
                experienceSelect.add(new Option(selectedExperience.name, selectedExperience.id));
            }
            experienceSelect.value = selectedExperience.id;
        }
        // Keep the scene when a saved copy changes its particle preset.
        const source = selectedExperience.particles.preset;
        const legacyScene = Array.from(canonicalExperienceIds).find(id =>
            selectedExperience.id === id || selectedExperience.id.startsWith(`${id}-custom-`));
        const inferredScene = source.includes('forest') ? 'forest' : source.includes('ocean') ? 'ocean'
            : source.includes('christmas') || source.includes('snow') ? 'christmas'
            : source.includes('storm') || source.includes('rain') ? 'storm'
            : source.includes('festival') || source.includes('firework') ? 'festival' : 'temple';
        const coverId = selectedExperience.sceneId && canonicalExperienceIds.has(selectedExperience.sceneId)
            ? selectedExperience.sceneId : legacyScene ?? inferredScene;
        selectedExperience.sceneId = coverId;
        if (previewStage instanceof HTMLElement) {
            previewStage.dataset.scene = selectedExperience.background ? 'custom' : coverId;
            const image = previewStage.querySelector<HTMLImageElement>('.preview-scene-image');
            if (image) image.src = selectedExperience.background ?? `/images/experience-covers/${coverId === 'festival' ? 'festival-evening' : coverId === 'storm' ? 'storm-balcony' : coverId}.jpg`;
            previewStage.setAttribute('aria-label', `${selectedExperience.name} atmosphere preview`);
        }
        const effectLabels: Record<string, [string, string, string]> = {
            'storm-rain': ['Rain', 'Rain amount', 'Wind'],
            'christmas-snow': ['Snow', 'Snow amount', 'Wind'],
            'forest-fireflies': ['Fireflies', 'Firefly count', 'Wander'],
            'ocean-spray': ['Wave shimmer', 'Shimmer amount', 'Drift'],
            'festival-dust': ['Floating dust', 'Dust amount', 'Drift'],
            'temple-embers': ['Embers', 'Ember count', 'Drift'],
        };
        const labels = effectLabels[selectedExperience.particles.preset] ?? ['Particles', 'Particle count', 'Drift'];
        for (const [id, text] of [['effect-section-label', labels[0]], ['effect-toggle-label', `${labels[0]} on`], ['effect-count-label', labels[1]], ['effect-drift-label', labels[2]]]) {
            const label = document.getElementById(id);
            if (label) label.textContent = text;
        }
        particleCountControl?.setAttribute('aria-label', labels[1]);
        particleDriftControl?.setAttribute('aria-label', labels[2]);
        const presetSelect = document.querySelector('#particle-preset-select');
        if (presetSelect instanceof HTMLSelectElement) {
            if (!Array.from(presetSelect.options).some(option => option.value === selectedExperience.particles.preset)) {
                presetSelect.add(new Option(selectedExperience.particles.preset, selectedExperience.particles.preset));
            }
            presetSelect.value = selectedExperience.particles.preset;
        }
        const audioSelect = document.querySelector('#main-audio-select');
        if (audioSelect instanceof HTMLSelectElement) audioSelect.value = selectedExperience.audio.track;
        const mainSoundName = document.querySelector('#main-sound-name');
        if (mainSoundName instanceof HTMLElement) {
            mainSoundName.textContent = `— ${formatTrackName(selectedExperience.audio.track)}`;
        }

        if (
            audioTrackTitle
            instanceof HTMLElement
        ) {
            audioTrackTitle.textContent =
                formatTrackName(
                    selectedExperience.audio.track
                );
        }

        const layerTitle = audioTracks.find(track => track.id === selectedExperience.audio.track)?.layerTitle;
        const layerControls = document.querySelector('#audio-layer-controls');
        const layerLabel = document.querySelector('#audio-layer-label');
        if (layerControls instanceof HTMLElement) {
            layerControls.hidden = !layerTitle;
        }
        if (layerLabel instanceof HTMLLabelElement) {
            layerLabel.textContent = `Atmosphere — ${layerTitle ?? ''}`;
        }
        if (layerVolumeValue instanceof HTMLOutputElement) {
            layerVolumeValue.value = `${selectedExperience.audio.layerVolume ?? 0}%`;
        }

        setInputValue(
            '#particle-count-control',
            selectedExperience.particles.count
        );

        setOutputValue(
            '#particle-count-value',
            selectedExperience.particles.count
        );

        const colourValues = {
            environment:
                selectedExperience.environment?.colour
                ?? selectedExperience.lighting.colour,
            lighting: selectedExperience.lighting.colour,
            particles: selectedExperience.particles.colour,
            fog: selectedExperience.fog.colour
        };

        Object.entries(colourValues).forEach(
            ([layer, colour]) => {
                setInputValue(
                    `#${layer}-colour-control`,
                    colour
                );

                setOutputValue(
                    `#${layer}-colour-value`,
                    colour.toUpperCase()
                );
            }
        );

        setInputValue(
            '#particle-glow-control',
            selectedExperience.particles.glow
        );

        setOutputValue(
            '#particle-glow-value',
            selectedExperience.particles.glow
        );

        setInputValue(
            '#particle-drift-control',
            selectedExperience.particles.drift
        );

        setOutputValue(
            '#particle-drift-value',
            selectedExperience.particles.drift
        );

        const particleRanges = [
            ['min-radius', 'minRadius', ''],
            ['max-radius', 'maxRadius', ''],
            ['min-speed', 'minSpeed', ''],
            ['max-speed', 'maxSpeed', ''],
            ['min-opacity', 'minOpacity', ''],
            ['max-opacity', 'maxOpacity', ''],
            ['min-lifetime', 'minLifetime', 's'],
            ['max-lifetime', 'maxLifetime', 's']
        ] as const;

        particleRanges.forEach(
            ([controlName, key, suffix]) => {
                const value =
                    selectedExperience.particles[key];

                setInputValue(
                    `#particle-${controlName}-control`,
                    value
                );

                setOutputValue(
                    `#particle-${controlName}-value`,
                    `${value}${suffix}`
                );
            }
        );

        updateDualRanges();

        experienceCards.forEach((card) => {
            const isActive =
                card.dataset.experienceId
                === selectedExperience.id;

            card.classList.toggle(
                'experience-card--active',
                isActive
            );

            card.setAttribute(
                'aria-pressed',
                String(isActive)
            );
        });
    };

    const emitParticleSettings = (): void => {
        if (!editableExperience) {
            return;
        }

        experienceRuntime.events.emit(
            'particles:settings-changed',
            {
                settings: {
                    ...editableExperience.particles
                }
            }
        );
    };

    type ColourLayer =
        | 'environment'
        | 'lighting'
        | 'particles'
        | 'fog';

    const bindColourControl = (
        control: Element | null,
        layer: ColourLayer
    ): void => {
        if (!(control instanceof HTMLInputElement)) {
            return;
        }

        control.addEventListener(
            'input',
            () => {
                if (!editableExperience) {
                    return;
                }

                const colour = control.value;

                setOutputValue(
                    `#${layer}-colour-value`,
                    colour.toUpperCase()
                );

                if (layer === 'environment') {
                    editableExperience.environment = {
                        colour
                    };
                    experienceState.data.environment.colour =
                        colour;
                    experienceRuntime.update(
                        experienceState.data
                    );
                    return;
                }

                if (layer === 'lighting') {
                    editableExperience.lighting.colour =
                        colour;
                    experienceState.data.lighting.colour =
                        colour;
                    experienceRuntime.update(
                        experienceState.data
                    );
                    return;
                }

                if (layer === 'fog') {
                    editableExperience.fog.colour = colour;
                    experienceState.data.fog.colour = colour;
                    experienceRuntime.update(
                        experienceState.data
                    );
                    return;
                }

                editableExperience.particles.colour =
                    colour;
                experienceState.data.particles.colour =
                    colour;
                updateDualRanges();
                emitParticleSettings();
            }
        );
    };

    type ParticleRangeKey =
        | 'minRadius'
        | 'maxRadius'
        | 'minSpeed'
        | 'maxSpeed'
        | 'minOpacity'
        | 'maxOpacity'
        | 'minLifetime'
        | 'maxLifetime';

    interface ParticleRangeBinding {
        control: Element | null;
        output: Element | null;
        key: ParticleRangeKey;
        pairedControl: Element | null;
        pairedOutput: Element | null;
        pairedKey: ParticleRangeKey;
        boundary: 'minimum' | 'maximum';
        suffix?: string;
    }

    const writeRangeOutput = (
        output: Element | null,
        value: number,
        suffix = ''
    ): void => {
        if (output instanceof HTMLOutputElement) {
            output.value = `${value}${suffix}`;
        }
    };

    const updateDualRanges = (): void => {
        document.querySelectorAll<HTMLElement>('[data-dual-range]').forEach(group => {
            const inputs = group.querySelectorAll<HTMLInputElement>('input[type="range"]');
            const [lower, upper] = Array.from(inputs);
            if (!lower || !upper) return;
            const low = Number(lower.min), span = Number(lower.max) - low;
            group.style.setProperty('--range-min', String((Number(lower.value) - low) / span));
            group.style.setProperty('--range-max', String((Number(upper.value) - low) / span));
            lower.setAttribute('aria-valuemax', upper.value);
            upper.setAttribute('aria-valuemin', lower.value);
        });
    };

    document.querySelectorAll<HTMLElement>('.dual-range-track').forEach(track => {
        const [lower, upper] = Array.from(track.querySelectorAll<HTMLInputElement>('input'));
        if (!lower || !upper) return;
        let active: HTMLInputElement | null = null;
        const valueAt = (event: PointerEvent): number => {
            const rect = track.getBoundingClientRect();
            const fraction = Math.max(0, Math.min(1, (event.clientX - rect.left - 10) / Math.max(1, rect.width - 20)));
            const low = Number(lower.min), step = Number(lower.step);
            return Number((low + Math.round(fraction * (Number(lower.max) - low) / step) * step).toFixed(6));
        };
        const move = (event: PointerEvent): void => {
            if (!active) return;
            const value = valueAt(event);
            active.value = String(active === lower ? Math.min(value, Number(upper.value)) : Math.max(value, Number(lower.value)));
            active.dispatchEvent(new Event('input', { bubbles: true }));
        };
        track.addEventListener('pointerdown', event => {
            if (event.button !== 0 || lower.disabled || upper.disabled) return;
            event.preventDefault();
            const value = valueAt(event);
            const leftDistance = Math.abs(value - Number(lower.value));
            const rightDistance = Math.abs(value - Number(upper.value));
            active = leftDistance < rightDistance || (leftDistance === rightDistance && value <= Number(lower.value)) ? lower : upper;
            active.focus({ preventScroll: true });
            track.setPointerCapture(event.pointerId);
            move(event);
        });
        track.addEventListener('pointermove', move);
        track.addEventListener('pointerup', () => { active = null; });
        track.addEventListener('pointercancel', () => { active = null; });
        track.addEventListener('lostpointercapture', () => { active = null; });
    });

    const bindParticleRange = ({
        control,
        output,
        key,
        pairedControl,
        pairedOutput,
        pairedKey,
        boundary,
        suffix = ''
    }: ParticleRangeBinding): void => {
        if (!(control instanceof HTMLInputElement)) {
            return;
        }

        control.addEventListener(
            'input',
            () => {
                if (!editableExperience) {
                    return;
                }

                let value = Number(control.value);

                if (!Number.isFinite(value)) {
                    return;
                }

                const pairedValue =
                    editableExperience.particles[pairedKey];

                if (
                    boundary === 'minimum' &&
                    value > pairedValue
                ) {
                    value = pairedValue;
                    control.value = String(value);
                }

                if (
                    boundary === 'maximum' &&
                    value < pairedValue
                ) {
                    value = pairedValue;
                    control.value = String(value);
                }

                editableExperience.particles[key] = value;

                writeRangeOutput(
                    output,
                    value,
                    suffix
                );

                if (
                    pairedControl instanceof HTMLInputElement
                ) {
                    pairedControl.value =
                        String(
                            editableExperience.particles[
                                pairedKey
                            ]
                        );
                }

                writeRangeOutput(
                    pairedOutput,
                    editableExperience.particles[pairedKey],
                    suffix
                );

                updateDualRanges();
                emitParticleSettings();
            }
        );
    };

