            setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
            instructions.textContent = 'HTML backdrop downloaded. In OBS, add or open a Browser source, tick Local File, browse to the newly downloaded aether-obs-backdrop.html, set Width to 1920 and Height to 1080, then click OK.';
