        urlInput.hidden = urlLabel.hidden = !!snapshot.background;
        if (snapshot.background) {
            const html = createBackdropHtml(url, snapshot.background);
            const objectUrl = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
