---
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Forest Transformation Lab — Aether" workspace="scene">
<main class="lab"><header><p class="eyebrow">Aether · Isolated visual experiment</p><h1>Forest Transformation Lab</h1><p>Test environmental change, not just a rain overlay. This is a compositing prototype using the existing forest photograph.</p></header>
<div class="layout"><section class="viewer"><div class="stage" id="stage" style="--storm:1;--sun:0;--wet:1;--mist:.12"><div class="base"></div><div class="cloud"></div><div class="wet"></div><div class="beams"></div><canvas id="atmosphere" aria-label="Animated environmental effects"></canvas></div><p id="status" role="status">Storm: darkened woodland, rain and wet ground</p></section><aside><h2>Transformation controls</h2><div class="buttons"><button data-scene="storm" aria-pressed="true">1 · Storm</button><button data-scene="clearing" aria-pressed="false">2 · Clearing</button><button data-scene="sunshine" aria-pressed="false">3 · Sunshine</button></div><button id="play">Play 30-second transformation</button><label for="progress">Transition position</label><input id="progress" type="range" min="0" max="100" value="0" step="1"/><p><strong>What to inspect</strong></p><p>Cloud shading, warm sunlight, ground sheen and drifting mist should change together. Rain and mist are animated, not baked into the image.</p><p class="note">Limit: this photograph has fixed shadows, sky and foliage. This prototype uses composited light and moisture layers, not genuine independent geometry or AI-generated matching states.</p></aside></div>
</main>
</StudioLayout>
<style>
.lab{max-width:1450px;margin:auto;padding:24px;color:#e7edf7}.lab header{margin-bottom:22px}.lab h1{margin:0 0 6px;font-size:clamp(26px,3vw,40px)}.lab p{color:#aebdd0;line-height:1.5}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.1em}.layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:18px}.viewer,aside{background:#152131;border:1px solid #304359;border-radius:16px;padding:16px}.stage{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:10px;background:#08120d;isolation:isolate}.stage>div,.stage>canvas{position:absolute;inset:0;width:100%;height:100%}.base{background:url('/images/experience-covers/forest.jpg') center/cover no-repeat;filter:brightness(calc(.63 + var(--sun)*.37)) saturate(calc(.72 + var(--sun)*.4));transition:filter .2s linear}.cloud{background:linear-gradient(180deg,rgba(11,22,33,.68),rgba(21,35,39,.38) 53%,transparent 90%);opacity:var(--storm);mix-blend-mode:multiply}.wet{background:radial-gradient(ellipse at 48% 81%,rgba(185,211,203,.27),transparent 36%),linear-gradient(0deg,rgba(15,40,36,.32),transparent 45%);opacity:var(--wet);mix-blend-mode:screen}.beams{background:conic-gradient(from 155deg at 66% 2%,transparent 0deg,rgba(255,215,137,.32) 7deg,transparent 15deg,rgba(255,227,162,.23) 24deg,transparent 33deg);opacity:var(--sun);mix-blend-mode:screen;filter:blur(15px)}canvas{pointer-events:none}.buttons{display:grid;gap:9px;margin:14px 0}.buttons button,#play{background:#1c3146;border:1px solid #49637b;color:#eef6ff;border-radius:9px;padding:13px;text-align:left;cursor:pointer;font:inherit}.buttons button[aria-pressed=true]{background:#21587b;border-color:#83c4ec}#play{background:#2773a4;width:100%;text-align:center;margin-bottom:18px}label{display:block;margin-bottom:9px}input{width:100%}.note{font-size:12px;border-top:1px solid #33485d;padding-top:14px}@media(max-width:850px){.layout{grid-template-columns:1fr}.lab{padding:14px}}
</style>
<script>
const stage=document.querySelector<HTMLElement>('#stage')!;const canvas=document.querySelector<HTMLCanvasElement>('#atmosphere')!;const ctx=canvas.getContext('2d')!;const slider=document.querySelector<HTMLInputElement>('#progress')!;const status=document.querySelector<HTMLElement>('#status')!;const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-scene]')];const play=document.querySelector<HTMLButtonElement>('#play')!;
let progress=0,playing=false,started=0,frame=0,last=0;const drops=Array.from({length:260},()=>({x:Math.random(),y:Math.random(),v:.4+Math.random()*.8,l:.009+Math.random()*.019,d:.5+Math.random()}));
const clamp=(v:number)=>Math.max(0,Math.min(1,v));const smooth=(a:number,b:number,v:number)=>{const t=clamp((v-a)/(b-a));return t*t*(3-2*t)};
function update(v:number){progress=clamp(v);slider.value=String(Math.round(progress*100));const storm=1-smooth(.08,.73,progress),sun=smooth(.34,.95,progress),wet=1-smooth(.57,1,progress)*.7,mist=smooth(.2,.53,progress)*(1-smooth(.72,1,progress));stage.style.setProperty('--storm',storm.toFixed(3));stage.style.setProperty('--sun',sun.toFixed(3));stage.style.setProperty('--wet',wet.toFixed(3));stage.style.setProperty('--mist',mist.toFixed(3));status.textContent=progress<.3?'Storm · rain, cool light and wet ground':progress<.76?'Clearing · rain eases, low mist rises and light warms':'Sunshine · mist disperses, warm light returns';buttons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===(progress<.3?0:progress<.76?1:2))));}
function resize(){const r=canvas.getBoundingClientRect();const d=Math.min(devicePixelRatio||1,1.5);canvas.width=Math.round(r.width*d);canvas.height=Math.round(r.height*d)}new ResizeObserver(resize).observe(canvas);
function tick(t:number){frame=requestAnimationFrame(tick);const dt=Math.min(.05,(t-(last||t))/1000);last=t;if(playing){update((t-started)/30000);if(progress>=1){playing=false;play.textContent='Replay 30-second transformation'}}const w=canvas.width,h=canvas.height;ctx.clearRect(0,0,w,h);const rain=1-smooth(.07,.5,progress),mist=smooth(.2,.53,progress)*(1-smooth(.72,1,progress));ctx.save();ctx.beginPath();ctx.rect(0,h*.24,w,h*.69);ctx.clip();for(const d of drops){d.y+=dt*d.v;d.x+=dt*.04;if(d.y>1){d.y=.18;d.x=Math.random()}if(d.x>1)d.x=0;if(Math.random()>rain)continue;ctx.strokeStyle=`rgba(200,225,237,${rain*.22*d.d})`;ctx.lineWidth=Math.max(.6,w/950*d.d);ctx.beginPath();ctx.moveTo(d.x*w,d.y*h);ctx.lineTo((d.x+.008*d.d)*w,(d.y+d.l*d.d)*h);ctx.stroke()}ctx.restore();if(mist>.002){for(let i=0;i<12;i++){const x=(.13+i*.071+Math.sin(t*.00013+i)*.018)*w,y=(.68+Math.sin(t*.00021+i*2)*.028-i*.002)*h;const rx=w*(.09+i%3*.02),ry=h*.055;const g=ctx.createRadialGradient(x,y,0,x,y,rx);g.addColorStop(0,`rgba(211,229,222,${mist*.10})`);g.addColorStop(1,'rgba(211,229,222,0)');ctx.save();ctx.translate(x,y);ctx.scale(1,ry/rx);ctx.translate(-x,-y);ctx.fillStyle=g;ctx.fillRect(x-rx,y-rx,rx*2,rx*2);ctx.restore()}}}
buttons.forEach((b,i)=>b.addEventListener('click',()=>{playing=false;play.textContent='Play 30-second transformation';update([0,.56,1][i])}));slider.addEventListener('input',()=>{playing=false;update(Number(slider.value)/100)});play.addEventListener('click',()=>{playing=true;started=performance.now();update(0);play.textContent='Playing transformation…'});update(0);frame=requestAnimationFrame(tick);document.addEventListener('astro:before-swap',()=>cancelAnimationFrame(frame),{once:true});
</script>
