<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Mersey Blue Hour V4.2</title></head><body>
<h1>Mersey Blue Hour V4.2</h1><p>Native WebGL | V4 baseline | Hardware validation</p>
<div id="stage"><img src="/scene-lab/mersey/mersey-base.webp" alt="Liverpool waterfront"/><canvas id="water"></canvas><output id="status">Loading assets</output></div>
<div id="controls">
{[{key:'wind',label:'Wind',min:0,max:1,value:.47},{key:'current',label:'Tidal current',min:-1,max:1,value:-.29},{key:'rough',label:'Roughness',min:0,max:1,value:.13},{key:'scale',label:'Wave scale',min:.4,max:2,value:.77},{key:'reflection',label:'Reflection',min:0,max:1,value:.84},{key:'shimmer',label:'Shimmer',min:0,max:1,value:.55}].map(p=><label>{p.label} <span data-value={p.key}>{p.value}</span><input data-key={p.key} type="range" min={p.min} max={p.max} step=".01" value={p.value}/></label>)}
<label>Effects resolution<select id="width"><option value="640">Economy</option><option value="850" selected>Pi 4</option><option value="1280">Standard</option><option value="1920">Premium</option></select></label><label>Frame cap<select id="fps"><option>30</option><option>60</option></select></label><button id="pause">Pause</button><button id="reset">Reset</button><button id="full">Fullscreen</button></div>
<script>
import { mountWaterShader } from './water-shader';
mountWaterShader();
</script>
<style>body{background:#111820;color:#eee;font:16px system-ui;margin:16px}#stage{position:relative;aspect-ratio:16/9;overflow:hidden;background:#000}img,canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}output{position:absolute;top:12px;left:12px;background:#000c;padding:8px;font:14px monospace}#controls{display:flex;flex-wrap:wrap;gap:20px;padding:20px 0;align-items:center}label{display:grid;gap:6px}button,select{padding:8px}</style>
</body></html>
