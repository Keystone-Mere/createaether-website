---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PostHog from '../components/posthog.astro';
import '../styles/design-system.css';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Aether creates adaptive, browser-rendered environmental canvases for hotels, spas and premium physical spaces."/><title>Environmental Canvas for premium spaces | Aether</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><PostHog /></head><body><SiteHeader/><main id="main">
<section class="hero"><div class="hero-copy"><p class="eyebrow">Aether Environmental Canvas</p><h1>Atmosphere, shaped by place.</h1><p class="lead">Adaptive environmental canvases for hotels, spas and premium interiors. Browser-rendered scenes with subtle motion, configurable weather and time-based states.</p><div class="actions"><a class="button primary" href="mailto:ben@keystonemere.com?subject=Aether%20Environmental%20Canvas%20Pilot">Discuss a pilot →</a><a class="button" href="/solutions/">Explore applications →</a></div><p class="micro">Technology demonstration · Commercial deployment under validation</p></div><div class="hero-art"><img src="/scene-lab/ullswater/ullswater-background.jpg" alt="Ullswater Retreat: Lake District-inspired environmental scene" fetchpriority="high"/><span class="image-label">ULLSWATER RETREAT · LIVE SCENE AVAILABLE</span></div></section>
<section class="feature-panel"><div><p class="eyebrow">Explore the environment</p><h2>Ullswater Retreat</h2><p>See rainfall, lake vapour, ripples and weather transitions in the existing Aether demonstration. This is a working scene, not a finished location-specific commercial collection.</p></div><a class="button primary" href="/scene-lab/ullswater/?player=1&amp;quality=pi4&amp;weather=auto" target="_blank" rel="noopener noreferrer">Launch live demonstration ↗</a></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">Designed for physical spaces</p><h2>One runtime. Different settings.</h2></div><a class="text-link" href="/solutions/">Explore solutions →</a></div><div class="use-grid"><article><span class="number">01 / HOSPITALITY</span><h3>Hotels & resorts</h3><p>Ambient displays for receptions, lounges and guest-facing interiors.</p></article><article><span class="number">02 / WELLNESS</span><h3>Spas & retreats</h3><p>Low-distraction, optionally silent environments for quiet spaces.</p></article><article><span class="number">03 / WORKPLACES</span><h3>Corporate lobbies</h3><p>Visual atmosphere for shared and public-facing interiors.</p></article></div></section>
<section class="local-panel"><div><p class="eyebrow">Future collection strategy</p><h2>Rooted in the location.</h2><p>Our planned environmental libraries will reflect each installation's geography, architecture and atmosphere. Ullswater and the tropical garden are development demonstrations, not a finished commercial catalogue.</p></div><div class="local-details"><span>PLACE</span><strong>Local landscape and identity</strong><span>STATE</span><strong>Time, weather and seasonal cues</strong><span>DISPLAY</span><strong>Performance tuned to the device</strong></div></section>
<section class="section split"><div><p class="eyebrow">The Aether runtime</p><h2>Rendered in the browser, not simply replayed.</h2></div><div><p>Aether combines scene imagery with parameterised visual effects. Environment state can be adjusted without replacing a conventional video loop. Hardware reliability, recovery and management are undergoing pilot validation.</p><a class="button" href="/technology/">Explore the technology →</a></div></section>
<section class="closing"><p class="eyebrow">Pilot enquiries</p><h2>Bring a responsive environment into your space.</h2><p>Discuss the display location, hardware, visual direction and pilot requirements.</p><a class="button primary" href="mailto:ben@keystonemere.com?subject=Aether%20Environmental%20Canvas%20Pilot">Request a pilot →</a></section><p class="other-tools">Looking for the original scene library, podcast or relaxation tools? <a href="/tools/">Explore other Aether tools →</a></p>
</main><SiteFooter/></body></html><style>
:global(html){background:#070b12;color:#f4f7ff;font-family:Inter,system-ui,sans-serif}:global(body){margin:0;background:radial-gradient(circle at 85% 3%,#172742 0%,transparent 34%),#070b12;color:#f4f7ff}:global(a){color:inherit}main{max-width:1200px;margin:auto;padding:55px 22px 105px}h1,h2,h3{letter-spacing:-.045em}h1{font-size:clamp(48px,6.6vw,90px);line-height:1.02;margin:15px 0 25px}h2{font-size:clamp(30px,3.5vw,48px);line-height:1.12;margin:12px 0 20px}h3{font-size:23px;margin:18px 0 8px}p{line-height:1.65;color:#b8c7dc}.eyebrow,.number{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:#7dd3fc;font-weight:800}.lead{font-size:clamp(17px,1.7vw,21px);max-width:580px}.hero{display:grid;grid-template-columns:1fr 1.08fr;gap:32px;align-items:center;min-height:520px}.hero-art{height:480px;position:relative;overflow:hidden;border:1px solid #334961;border-radius:20px;background:#17243a}.hero-art img{width:100%;height:100%;object-fit:cover;display:block}.image-label{position:absolute;left:18px;bottom:18px;background:#07111bdb;border:1px solid #5a7083;border-radius:7px;padding:10px 12px;font-size:11px;font-weight:800;letter-spacing:.12em}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 16px}.button{display:inline-block;border:1px solid #48607b;border-radius:999px;padding:13px 20px;text-decoration:none;font-weight:750;transition:background .2s}.button:hover{background:#213149}.button.primary{background:#d9f5ed;border-color:#d9f5ed;color:#092019}.button.primary:hover{background:#bcebdc}.micro{font-size:12px;color:#8ba1b8}.feature-panel{display:flex;align-items:center;justify-content:space-between;gap:35px;background:#101b2c;border:1px solid #2b4059;border-radius:18px;padding:26px 32px;margin:32px 0 90px}.feature-panel p{max-width:650px}.feature-panel .button{flex-shrink:0}.section{border-top:1px solid #243248;padding-top:58px;margin:70px 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px}.text-link{color:#8edfff;text-decoration:none;font-weight:700}.use-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:25px}.use-grid article{background:#101b2c;border:1px solid #2a4058;border-radius:16px;padding:30px;min-height:180px}.use-grid p{font-size:15px}.local-panel{display:grid;grid-template-columns:1.3fr 1fr;gap:50px;padding:48px;border-radius:22px;background:linear-gradient(115deg,#122842,#0c1624);border:1px solid #35516a}.local-details{display:grid;grid-template-columns:75px 1fr;gap:15px;align-content:center}.local-details span{color:#7dd3fc;font-size:11px;letter-spacing:.12em}.local-details strong{font-size:15px}.split{display:grid;grid-template-columns:1fr 1fr;gap:60px}.closing{text-align:center;background:#101b2c;border:1px solid #2b4059;border-radius:22px;padding:52px 25px}.closing p{margin-left:auto;margin-right:auto}.closing .button{margin-top:12px}.other-tools{text-align:center;font-size:13px;margin-top:48px}.other-tools a{color:#8edfff}@media(max-width:850px){.hero,.local-panel,.split{grid-template-columns:1fr}.hero{min-height:0}.hero-art{height:390px}.feature-panel{flex-direction:column;align-items:flex-start}.use-grid{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column}}@media(max-width:520px){main{padding:28px 16px 65px}.hero-art{height:300px}.local-panel{padding:26px}.feature-panel{padding:22px}.local-details{grid-template-columns:1fr;gap:7px}.local-details strong{margin-bottom:12px}}
</style>