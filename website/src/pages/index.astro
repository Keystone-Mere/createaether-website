---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PostHog from '../components/posthog.astro';
import '../styles/design-system.css';
const demo = '/scene-lab/ullswater/?player=1&quality=pi4&weather=auto';
const pilot = 'mailto:ben@keystonemere.com?subject=Aether%20Environmental%20Canvas%20Pilot';
const sectors = [
 {title:'Hotels & resorts', image:'hotel-lobby.webp', description:'Create a distinctive sense of arrival in receptions and guest lounges.'},
 {title:'Spas & retreats', image:'spa-lounge.webp', description:'Introduce gentle visual movement into quiet, optionally silent spaces.'},
 {title:'Corporate lobbies', image:'corporate-lobby.webp', description:'Give shared interiors a visual identity that evolves throughout the day.'},
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Adaptive, real-time environmental displays for hotels, spas and premium commercial interiors."/>
<title>Environmental Canvas for premium spaces | Aether</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><PostHog />
</head>
<body><SiteHeader/><main id="main">
<section class="hero">
<div><p class="eyebrow">Environmental Canvas technology</p><h1>Transform screens into living environments.</h1><p class="lead">Adaptive digital environments for hotels, spas and premium commercial interiors. Rendered in real time, shaped by place and designed to evolve throughout the day.</p><div class="actions"><a class="button primary" href="#experience" id="experience-link">Experience Aether</a><a class="button" href={pilot}>Request a pilot</a></div><p class="micro">Working technology demonstration · Commercial deployment under validation</p></div>
<div class="demo" id="experience" data-demo={demo}><div class="screen" id="demo-screen"><img src="/scene-lab/ullswater/ullswater-background.jpg" alt="Ullswater Retreat, a Lake District-inspired environment" fetchpriority="high"/><button type="button" class="play" id="demo-start" hidden>Play live scene</button></div><div class="demo-bar"><div><strong>Ullswater Retreat</strong><p class="micro" id="demo-status" aria-live="polite">Real-time scene demonstration</p></div><div class="demo-actions"><button type="button" id="demo-stop" hidden>Close scene</button><a href={demo} target="_blank" rel="noopener noreferrer">Open full scene ↗</a></div></div></div>
</section>
<section class="pillars" aria-label="Technology highlights"><article><h2>Real-time rendering</h2><p>Visual effects generated in the browser, rather than a fixed video loop.</p></article><article><h2>Adaptive atmosphere</h2><p>Configurable rain, ripples, vapour and scheduled environmental states.</p></article><article><h2>Lightweight engine</h2><p>Designed with low-overhead display hardware in mind.</p></article></section>
<section class="section"><p class="eyebrow">Designed for physical spaces</p><h2>One runtime. Different settings.</h2><div class="sectors">{sectors.map(sector => <article><img src={'/images/commercial/'+sector.image} alt={sector.title+' installation concept'} loading="lazy"/><div class="sector-copy"><p class="micro">AI-generated installation concept</p><h3>{sector.title}</h3><p>{sector.description}</p></div></article>)}</div><p class="micro">Illustrative concepts, not completed customer installations.</p><a class="text-link" href="/solutions/">Explore solutions →</a></section>
<section class="section split"><div><p class="eyebrow">Beyond the video loop</p><h2>Atmosphere that responds to state.</h2></div><div><p>Aether combines scene imagery with parameterised visual effects. Time cues and environmental settings can change the scene without replacing a video file.</p><p>Local rendering, device recovery and long-duration performance are undergoing pilot validation.</p><a class="button" href="/technology/">Explore the technology</a></div></section>
<section class="local"><p class="eyebrow">Collection direction</p><h2>Rooted in the location.</h2><p>Our planned environmental collections will reflect the geography, architecture and atmosphere of each installation. Ullswater and the tropical garden are development demonstrations, not a finished commercial catalogue.</p><a class="text-link" href="/environmental-canvas/">Discover Environmental Canvas →</a></section>
<section class="closing"><p class="eyebrow">Pilot enquiries</p><h2>Bring Aether into your space.</h2><p>Discuss your display location, hardware, visual direction and pilot requirements.</p><a class="button primary" href={pilot}>Request a pilot</a></section>
<p class="other">Looking for the original scene library, podcast or relaxation tools? <a href="/tools/">Explore other Aether tools.</a></p>
</main><SiteFooter/>
<script>
const demo = document.querySelector<HTMLElement>('#experience');
const screen = document.querySelector<HTMLElement>('#demo-screen');
const start = document.querySelector<HTMLButtonElement>('#demo-start');
const stop = document.querySelector<HTMLButtonElement>('#demo-stop');
const status = document.querySelector<HTMLElement>('#demo-status');
const link = document.querySelector<HTMLAnchorElement>('#experience-link');
let frame: HTMLIFrameElement | null = null;
if (demo && screen && start && stop && status && link) {
  start.hidden = false;
  const close = (focus = false) => {
    frame?.remove(); frame = null; start.hidden = false; stop.hidden = true;
    status.textContent = 'Real-time scene demonstration';
    if (focus) start.focus();
  };
  const open = () => {
    if (frame || !demo.dataset.demo) return;
    frame = document.createElement('iframe');
    frame.title = 'Aether Ullswater live scene'; frame.src = demo.dataset.demo;
    frame.allowFullscreen = true;
    screen.append(frame); start.hidden = true; stop.hidden = false;
    status.textContent = 'Live scene opened'; stop.focus();
  };
  start.addEventListener('click', open);
  stop.addEventListener('click', () => close(true));
  link.addEventListener('click', () => { open(); });
  window.addEventListener('pagehide', () => close());
}
</script>
</body></html>
<style>
:global(html){background:#070b12;color:#f4f7ff;font-family:Inter,system-ui,sans-serif}:global(body){background:radial-gradient(circle at 85% 3%,#172742 0%,transparent 34%),#070b12;color:#f4f7ff}main{max-width:1200px;margin:auto;padding:52px 22px 55px}h1,h2,h3{letter-spacing:-.045em;line-height:1.12}h1{font-size:clamp(42px,5.5vw,76px);margin:16px 0 22px}h2{font-size:clamp(30px,3.5vw,48px);margin:12px 0 18px}h3{font-size:24px;margin:10px 0}p{color:#b8c7dc;line-height:1.65}.eyebrow{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:#7dd3fc;font-weight:800}.lead{font-size:clamp(17px,1.7vw,21px)}.hero{display:grid;grid-template-columns:1fr 1.15fr;gap:36px;align-items:center}.actions,.demo-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.actions{margin:28px 0 14px}.button,.play{display:inline-block;border:1px solid #48607b;border-radius:999px;padding:13px 20px;text-decoration:none;font-weight:750;color:inherit;background:transparent;cursor:pointer;font:inherit;font-weight:750}.primary,.play{background:#d9f5ed;color:#092019;border-color:#d9f5ed}.button:hover,.play:hover{filter:brightness(1.1)}.micro{font-size:12px;color:#9eb1c7}.demo{border:1px solid #334961;border-radius:18px;overflow:hidden;background:#101b2c;scroll-margin-top:20px}.screen{position:relative;aspect-ratio:16/10;background:#080f17;overflow:hidden}.screen img{width:100%;height:100%;object-fit:cover}.screen :global(iframe){position:absolute;inset:0;width:100%;height:100%;border:0;background:#080f17}.play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);white-space:nowrap;box-shadow:0 4px 30px #0008}.demo-bar{padding:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.demo-bar p{margin:4px 0 0}.demo-actions a,.demo-actions button,.text-link,.other a{color:#8edfff;font-size:14px}.demo-actions button{background:transparent;border:1px solid #48607b;border-radius:8px;padding:8px;cursor:pointer}[hidden]{display:none!important}.pillars,.sectors{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.pillars{margin:48px 0 0}.pillars article,.sectors article{border:1px solid #2a4058;background:#101b2c;border-radius:16px;overflow:hidden}.pillars article,.sector-copy{padding:24px}.pillars h2{font-size:21px;margin:0}.pillars p,.sector-copy p{margin-bottom:0}.sectors img{width:100%;aspect-ratio:16/10;object-fit:cover}.section{border-top:1px solid #243248;padding-top:48px;margin:65px 0}.split{display:grid;grid-template-columns:1fr 1fr;gap:48px}.local,.closing{border:1px solid #35516a;border-radius:20px;background:#101b2c;padding:40px;margin:48px 0}.local p{max-width:760px}.closing{text-align:center}.other{text-align:center;font-size:13px}a:focus-visible,button:focus-visible{outline:2px solid #7dd3fc;outline-offset:4px}@media(max-width:850px){.hero,.split{grid-template-columns:1fr}.pillars,.sectors{grid-template-columns:1fr}.hero{gap:24px}}@media(max-width:520px){main{padding:25px 16px 40px}.local,.closing{padding:24px}.demo-bar{padding:12px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
