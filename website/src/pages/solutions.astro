---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PostHog from '../components/posthog.astro';
import '../styles/design-system.css';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Aether Environmental Canvas use cases for premium spaces."/><title>Solutions | Aether</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><PostHog /></head><body><SiteHeader/><main id="main"><section class="intro"><p class="eyebrow">Commercial applications</p><h1>Designed around the space.</h1><p class="lead">Environmental canvases can bring subtle, responsive atmosphere to premium interiors. These examples are illustrative installation concepts, not completed customer projects.</p></section>
<section class="scenario"><div class="concept"><div class="screen"><img src="/scene-lab/ullswater/ullswater-background.jpg" alt="Ullswater environment shown in an illustrative display frame"/></div><span>ILLUSTRATIVE SCREEN CONCEPT · NOT A CUSTOMER INSTALLATION</span></div><div class="scenario-copy"><p class="eyebrow">01 / Hospitality</p><h2>Hotels & resorts</h2><p>Welcome guests with an environment that reflects the property's identity, rather than a generic repeating playlist.</p><p class="note">Potential placement: reception, lounge or quiet guest area.</p></div></section>
<section class="scenario reverse"><div class="concept spa"><div class="screen"><img src="/scene-lab/ullswater/ullswater-background.jpg" alt="Ullswater scene in an illustrative wellness display frame" loading="lazy"/></div><span>ILLUSTRATIVE SCREEN CONCEPT · NOT A CUSTOMER INSTALLATION</span></div><div class="scenario-copy"><p class="eyebrow">02 / Wellness</p><h2>Spas & retreats</h2><p>Low-distraction environmental movement for relaxation lounges and quiet areas, with silent operation where required.</p><p class="note">Potential placement: relaxation room or treatment waiting area.</p></div></section>
<section class="scenario"><div class="concept office"><div class="screen"><img src="/scene-lab/ullswater/ullswater-background.jpg" alt="Ullswater scene in an illustrative corporate display frame" loading="lazy"/></div><span>ILLUSTRATIVE SCREEN CONCEPT · NOT A CUSTOMER INSTALLATION</span></div><div class="scenario-copy"><p class="eyebrow">03 / Workplaces</p><h2>Corporate lobbies</h2><p>A distinctive visual layer for shared spaces, with configurable motion and environment states.</p><p class="note">Potential placement: reception or public-facing lobby.</p></div></section>
<section class="future"><p class="eyebrow">Planned content direction</p><h2>Collections informed by place.</h2><p>Future libraries are intended to reflect each installation's geography, architecture and seasonal character. Current scenes demonstrate the engine, not a complete local catalogue.</p><a class="button primary" href="mailto:ben@keystonemere.com?subject=Aether%20Environmental%20Canvas%20Pilot">Discuss your installation →</a></section></main><SiteFooter/></body></html><style>
:global(html){background:#070b12;color:#f4f7ff;font-family:Inter,system-ui,sans-serif}:global(body){margin:0;background:radial-gradient(circle at 85% 5%,#172742 0%,transparent 35%),#070b12;color:#f4f7ff}:global(a){color:inherit}main{max-width:1200px;margin:auto;padding:58px 22px 110px}h1,h2{letter-spacing:-.05em;line-height:1.08}h1{font-size:clamp(48px,6vw,82px);margin:18px 0}h2{font-size:clamp(32px,3.5vw,48px);margin:10px 0 20px}p{line-height:1.7;color:#b8c7dc}.eyebrow{color:#7dd3fc;letter-spacing:.17em;text-transform:uppercase;font-size:11px;font-weight:800}.lead{font-size:clamp(18px,2vw,22px);max-width:780px}.intro{margin-bottom:75px}.scenario{display:grid;grid-template-columns:1.2fr 1fr;gap:55px;align-items:center;padding:55px 0;border-top:1px solid #243248}.scenario.reverse .concept{order:2}.scenario.reverse .scenario-copy{order:1}.scenario-copy p{max-width:450px}.note{font-size:14px;color:#89a4be}.concept{padding:35px 35px 16px;background:linear-gradient(140deg,#2b3036,#151b24);border:1px solid #35475c;border-radius:18px;box-shadow:inset 0 0 65px #080d17;min-height:300px;display:flex;flex-direction:column;justify-content:center}.concept.spa{background:linear-gradient(140deg,#34352d,#171e1b)}.concept.office{background:linear-gradient(140deg,#303b4c,#151d2b)}.screen{border:9px solid #080c12;border-radius:6px;box-shadow:0 14px 28px #0009;aspect-ratio:16/9;overflow:hidden;background:#121d2d}.screen img{width:100%;height:100%;object-fit:cover;display:block}.concept span{font-size:9px;letter-spacing:.12em;color:#c3d3e1;margin-top:22px;text-align:center}.future{background:#101b2c;border:1px solid #30455d;border-radius:22px;padding:46px;margin-top:55px}.future p{max-width:690px}.button{display:inline-block;border:1px solid #40536d;padding:14px 20px;border-radius:999px;text-decoration:none;font-weight:700;margin-top:15px}.primary{background:#d9f5ed;color:#092019;border-color:#d9f5ed}@media(max-width:800px){.scenario{grid-template-columns:1fr;gap:20px}.scenario.reverse .concept,.scenario.reverse .scenario-copy{order:initial}}@media(max-width:520px){main{padding:28px 16px 65px}.concept{padding:18px 18px 12px;min-height:210px}.future{padding:26px}}
</style>