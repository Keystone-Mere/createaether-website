---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PostHog from '../components/posthog.astro';
import '../styles/design-system.css';
const pilot = 'mailto:ben@keystonemere.com?subject=Aether%20Environmental%20Canvas%20Pilot';
const markets = [
 {label:'01 / Hospitality', title:'Hotels & resorts', image:'hotel-lobby.webp', alt:'Illustrative hotel reception with a landscape display', description:'Create a distinctive sense of arrival with an evolving landscape that complements the identity of your property.', placements:'Receptions, guest lounges and quiet communal areas.', value:'Explore location-inspired imagery and scheduled changes in atmosphere.'},
 {label:'02 / Wellness', title:'Spas & retreats', image:'spa-lounge.webp', alt:'Illustrative spa lounge with a landscape display', description:'Introduce gentle environmental movement into spaces designed for rest, with visual intensity tailored to the setting.', placements:'Relaxation lounges and treatment waiting areas.', value:'Configure subtle motion and silent operation where required.'},
 {label:'03 / Workplaces', title:'Corporate lobbies', image:'corporate-lobby.webp', alt:'Illustrative corporate reception with a landscape display', description:'Give shared interiors a distinctive visual identity that can evolve throughout the working day.', placements:'Reception areas, visitor lounges and shared interiors.', value:'Explore scheduled atmosphere and imagery aligned with the building.'}
];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Explore Aether Environmental Canvas for hotels, spas and premium commercial interiors."/><title>Commercial Solutions | Aether</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><PostHog /></head>
<body><SiteHeader/><main id="main">
<section class="intro"><p class="eyebrow">Commercial applications</p><h1>Atmosphere designed around your space.</h1><p class="lead">Turn a commercial display into an evolving environmental canvas, with visual character and motion suited to the people and places around it.</p><div class="actions"><a class="button primary" href={pilot}>Discuss your venue</a><a class="button" href="/environmental-canvas/">Explore the product</a></div></section>
{markets.map((market,i)=>(<section class:list={['scenario', {reverse:i===1}]}><figure><img src={'/images/commercial/'+market.image} alt={market.alt} loading={i===0?'eager':'lazy'} decoding="async"/><figcaption>AI-generated installation concept. Not a customer installation.</figcaption></figure><div class="copy"><p class="eyebrow">{market.label}</p><h2>{market.title}</h2><p class="description">{market.description}</p><div class="detail"><strong>Potential placements</strong><p>{market.placements}</p></div><div class="detail"><strong>Environmental direction</strong><p>{market.value}</p></div><a class="text-link" href={pilot}>Discuss a pilot →</a></div></section>))}
<section class="panel split"><div><p class="eyebrow">Architectural opportunities</p><h2>Premium property & interiors.</h2><p>Explore environmental displays as part of a new interior specification or refurbishment. Screen placement, viewing distance, power, connectivity and maintenance access should be considered early.</p></div><div><p class="eyebrow">Collection direction</p><h2>Rooted in the location.</h2><p>Our planned collections will reflect the geography and visual identity of individual venues. Bespoke scenes are subject to production scope and content rights.</p></div></section>
<section class="section"><p class="eyebrow">Planning your installation</p><h2>Start with the space, not the screen.</h2><div class="cards"><article><h3>Assess the venue</h3><p>Identify the audience, display location, ambient lighting and existing hardware.</p></article><article><h3>Configure the environment</h3><p>Agree the scene, motion intensity, schedule and audio requirements.</p></article><article><h3>Evaluate the pilot</h3><p>Review visual suitability, playback stability and support requirements before expansion.</p></article></div><p class="note">Commercial deployment is under validation. Hardware compatibility, content rights, installation costs and support terms are agreed individually.</p></section>
<section class="panel closing"><p class="eyebrow">Pilot enquiries</p><h2>Explore Aether for your venue.</h2><p>Tell us about your space, existing displays and the atmosphere you want to create.</p><a class="button primary" href={pilot}>Request a pilot</a></section>
</main><SiteFooter/></body></html>
<style>
:global(html){background:#070b12;color:#f4f7ff;font-family:Inter,system-ui,sans-serif}:global(body){background:radial-gradient(circle at 85% 5%,#172742 0%,transparent 35%),#070b12;color:#f4f7ff}main{max-width:1200px;margin:auto;padding:55px 22px 45px}h1,h2,h3{letter-spacing:-.045em;line-height:1.1}h1{font-size:clamp(44px,6vw,78px);max-width:950px;margin:16px 0 24px}h2{font-size:clamp(30px,3.5vw,46px);margin:12px 0 20px}h3{font-size:22px;margin:0 0 12px}p{line-height:1.7;color:#b8c7dc}.eyebrow{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:#7dd3fc;font-weight:800}.lead{font-size:clamp(18px,2vw,22px);max-width:780px}.intro{margin-bottom:55px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0}.button{display:inline-block;border:1px solid #48607b;border-radius:999px;padding:13px 20px;text-decoration:none;font-weight:750}.primary{background:#d9f5ed;border-color:#d9f5ed;color:#092019}.button:hover{filter:brightness(1.12)}a:focus-visible{outline:2px solid #7dd3fc;outline-offset:4px}.scenario{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:center;border-top:1px solid #243248;padding:48px 0}.reverse figure{order:2}.reverse .copy{order:1}figure{margin:0;background:#101b2c;border:1px solid #30455d;border-radius:16px;overflow:hidden}figure img{width:100%;aspect-ratio:16/10;object-fit:cover}figcaption{padding:12px 16px;color:#b8c7dc;font-size:12px}.description{font-size:18px}.detail{border-top:1px solid #243248;padding-top:12px;margin-top:16px}.detail strong{font-size:14px}.detail p{margin:5px 0 12px}.text-link{color:#8edfff;font-weight:700}.panel,.cards article{background:#101b2c;border:1px solid #30455d;border-radius:16px;padding:30px}.split{display:grid;grid-template-columns:1fr 1fr;gap:40px}.section{border-top:1px solid #243248;margin:55px 0;padding-top:40px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.note{font-size:14px}.closing{text-align:center;padding:42px 24px}.closing .button{margin-top:10px}@media(max-width:800px){.scenario,.split,.cards{grid-template-columns:1fr;gap:22px}.reverse figure,.reverse .copy{order:initial}}@media(max-width:520px){main{padding:28px 16px 35px}.panel,.cards article{padding:22px}.scenario{padding:30px 0}}
</style>
