---
import SiteHeader from '../components/SiteHeader.astro';


import '../styles/design-system.css';
import '../styles/animations.css';
import '../styles/components.css';
import PostHog from '../components/posthog.astro';

const features = [{"number": "01", "id": "scenes", "eyebrow": "Scene library", "title": "Find a setting that feels right.", "text": "Start with a ready-made environment or upload a background in the scene editor.", "items": ["Background choices", "Your own image uploads", "Live scene preview", "Full-screen viewing"]}, {"number": "02", "id": "podcast", "eyebrow": "Podcast & Stream", "title": "Give your show a consistent look.", "text": "Create a reusable show setting and bring it into OBS for recording or streaming.", "items": ["One host, two people or no frames", "Show titles, names, colour and logo", "Starting Soon, Live, Be Right Back and Ending", "Four-scene OBS collection export"]}, {"number": "03", "id": "relaxation", "eyebrow": "Relaxation", "title": "Make time for a quiet moment.", "text": "Choose a setting, duration and optional on-screen guidance in the relaxation session builder.", "items": ["5, 10 or 20 minutes, or untimed", "Relax, focus or rest", "Optional guidance and sound where available", "Immersive underwater view and creature controls"]}, {"number": "04", "id": "atmosphere", "eyebrow": "Atmosphere controls", "title": "Shape the mood of your scene.", "text": "Adjust the effects available for your chosen experience and see the result as you edit.", "items": ["Layered audio and volume controls", "Lighting and colour", "Fog, weather and particles", "Scene-specific presets and settings"]}, {"number": "05", "id": "saved", "eyebrow": "Your experiences", "title": "Keep a version of your own.", "text": "Save an edited experience as a copy, then find it again in My saved in the scene library in the same browser.", "items": ["Name your creation", "Rename or delete saved copies", "Import an exported experience", "Local browser storage on this device"]}, {"number": "06", "id": "obs", "eyebrow": "OBS workflow", "title": "Take your setting into your show.", "text": "Export silent browser-rendered visuals, then add your cameras and microphone in OBS.", "items": ["Copy an OBS playback link", "Download an HTML backdrop file", "Include a logo with the supported file export", "Export again after editing"]}];
import SiteFooter from '../components/SiteFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Explore Aether’s relaxation sessions, scene editor, podcast branding and silent OBS exports."
    />
    <title>Features — Aether</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PostHog />
  </head>

  <body>
    <SiteHeader />

    <main id="main">
      <section class="features-hero">
        <div class="features-hero-grid" aria-hidden="true"></div>

        <div class="features-hero-content">
          <p class="eyebrow">Aether Features</p>

          <h1>One engine. Atmosphere for your show and your space.</h1>

          <p class="features-intro">
            Build a relaxation session, personalise a podcast setting, or shape an environment with sound, lighting and animated effects.
          </p>

          <div class="actions">
            <a class="button primary" href="#platform">
              Explore the features ↓
            </a>

            <a class="button secondary" href="/studio/">
              Browse scene library →
            </a>
          </div>
        </div>
      </section>

      <section class="platform-introduction" id="platform">
        <p class="eyebrow">Create in your browser</p>

        <h2>Choose your scene. Make it yours.</h2>

        <p>
          Start with a ready-made setting and use the controls available for that experience. Enjoy it in full screen, save your own version, or export its visuals to OBS.
        </p>
      </section>

      <section
        class="features-grid"
        aria-label="Aether platform features"
      >
        {
          features.map((feature) => (
            <article class="feature-card" id={feature.id}>
              <div class="feature-number" aria-hidden="true">
                {feature.number}
              </div>

              <p class="eyebrow">{feature.eyebrow}</p>
              <h2>{feature.title}</h2>
              <p>{feature.text}</p>

              <ul>
                {feature.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </section>



      <section class="features-cta">
        <p class="eyebrow">Start creating</p>
        <h2>What would you like to create?</h2>

        <p>
          Set the scene for your next episode, or take a moment to unwind.
        </p>

        <div class="actions">
          <a class="button primary" href="/studio/">
            Browse scene library →
          </a>

          <a
            class="button secondary"
            href="/studio/guided-relaxation/"
            target="_blank"
            rel="noreferrer"
          >
            Try relaxation
          </a>
        </div>
      </section>
      <section class="technology-note" id="architecture"><h2>Built on the Aether atmosphere engine</h2><p>A shared browser runtime brings scenes, audio and visual effects together. For technical details and the current source, visit <a href="https://github.com/Keystone-Mere/createaether-website" target="_blank" rel="noopener noreferrer">GitHub ↗</a>.</p></section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
.site-header {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  padding: 34px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-header a {
  color: inherit;
  text-decoration: none;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.brand-logo {
  width: 52px;
  height: 52px;
  display: block;
  flex-shrink: 0;
}

.brand span {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.site-header nav {
  display: flex;
  gap: 28px;
  color: #aaaeb8;
  font-size: 0.92rem;
}

.site-header nav a:hover,
.site-header nav a[aria-current="page"] {
  color: #ffffff;
}
  .features-hero {
    position: relative;
    min-height: 72vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    padding: 10rem clamp(1.5rem, 6vw, 7rem) 6rem;
  }

  .features-hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(121, 225, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(121, 225, 255, 0.08) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .features-hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .features-hero h1 {
    max-width: 820px;
    margin: 1rem 0 1.5rem;
    font-size: clamp(3.4rem, 8vw, 7.2rem);
    line-height: 0.94;
  }

  .features-intro {
    max-width: 720px;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.75;
  }

  .platform-introduction,
  .developer-example,
  .features-cta {
    width: min(1180px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .platform-introduction {
    padding: 8rem 0 5rem;
    max-width: 900px;
    text-align: center;
  }

  .platform-introduction h2,
  .features-cta h2 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
  }

  .platform-introduction > p:last-child,
  .features-cta > p {
    max-width: 760px;
    margin-inline: auto;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .features-grid {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-bottom: 8rem;
  }

  .feature-card {
    position: relative;
    min-height: 440px;
    padding: clamp(2rem, 4vw, 3.25rem);
    border: 1px solid rgba(151, 225, 255, 0.14);
    border-radius: 1.5rem;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        rgba(24, 38, 59, 0.58),
        rgba(6, 13, 25, 0.72)
      );
  }

  .feature-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 220px;
    right: -100px;
    bottom: -120px;
    border-radius: 50%;
    background: rgba(69, 210, 255, 0.08);
    filter: blur(35px);
    pointer-events: none;
  }

  .feature-number {
    margin-bottom: 4rem;
    color: rgba(151, 225, 255, 0.38);
    font-family: monospace;
    letter-spacing: 0.18em;
  }

  .feature-card h2 {
    margin: 0.8rem 0 1rem;
    max-width: 520px;
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .feature-card > p:last-of-type {
    line-height: 1.75;
  }

  .feature-card ul {
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    list-style: none;
  }

  .feature-card li::before {
    content: '—';
    margin-right: 0.7rem;
    color: rgba(121, 225, 255, 0.9);
  }

  .developer-example {
    padding: 7rem 0;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .developer-example h2 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.5rem, 4vw, 4rem);
  }

  .developer-example p {
    line-height: 1.8;
  }

  .developer-example pre {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    overflow-x: auto;
    border: 1px solid rgba(151, 225, 255, 0.16);
    border-radius: 1.25rem;
    background: rgba(3, 9, 18, 0.88);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
  }

  .developer-example code {
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .features-cta {
    margin-bottom: 5rem;
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem);
    text-align: center;
    border: 1px solid rgba(151, 225, 255, 0.15);
    border-radius: 1.75rem;
    background:
      radial-gradient(
        circle at top,
        rgba(48, 191, 255, 0.12),
        transparent 58%
      ),
      rgba(8, 17, 31, 0.62);
  }

  .features-cta .actions {
    justify-content: center;
  }

  @media (max-width: 800px) {
    .features-grid,
    .developer-example {
      grid-template-columns: 1fr;
    }

    .features-hero {
      min-height: auto;
      padding-top: 9rem;
    }

    .feature-card {
      min-height: auto;
    }
  }
.engine-layers { padding:64px 0; }
</style>

<style>.technology-note{width:min(1180px,calc(100% - 3rem));margin:48px auto;color:#cbd5e1;line-height:1.8}.technology-note a{color:#7dd3fc}.features-hero{min-height:auto;padding:56px max(24px,calc((100% - 1180px)/2)) 64px}.features-hero h1{font-size:clamp(2.7rem,6vw,5.5rem)}.platform-introduction{padding:48px 0}.feature-card{min-height:0;padding:28px}.feature-number{margin-bottom:24px}.features-grid{padding-bottom:48px}</style>
