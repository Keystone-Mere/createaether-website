---
import '../styles/design-system.css';
import '../styles/animations.css';
import '../styles/components.css';
import PostHog from '../components/posthog.astro';

const features = [
  {
    number: '01',
    id: 'audio',
    eyebrow: 'Experience Audio',
    title: 'Adaptive sound that responds to the experience.',
    text: 'Aether coordinates ambient soundscapes, playback state, volume and user interaction through one consistent experience system.',
    items: [
      'Adaptive soundscapes',
      'Experience-aware playback',
      'Persistent user controls',
      'Smooth transitions',
    ],
  },
  {
    number: '02',
    id: 'lighting',
    eyebrow: 'Experience Lighting',
    title: 'Create atmosphere through light.',
    text: 'Lighting reinforces mood, guides attention and gives every digital experience a distinctive visual identity.',
    items: [
      'Dynamic glow',
      'Colour themes',
      'Responsive intensity',
      'Atmospheric transitions',
    ],
  },
  {
    number: '03',
    id: 'particles',
    eyebrow: 'Experience Particles',
    title: 'Bring digital environments to life.',
    text: 'Subtle movement adds depth and atmosphere while remaining connected to the active experience configuration.',
    items: [
      'Dust and embers',
      'Mist and atmospheric drift',
      'Weather effects',
      'Reusable presets',
    ],
  },
  {
    number: '04',
    id: 'runtime',
    eyebrow: 'Experience Runtime',
    title: 'One orchestration layer for every system.',
    text: 'Aether coordinates audio, lighting, particles and configuration through a modular event-driven runtime.',
    items: [
      'Event dispatcher',
      'Module registry',
      'Services registry',
      'Experience Manager',
    ],
  },
  {
    number: '05',
    id: 'studio',
    eyebrow: 'Aether Studio',
    title: 'Design and preview experiences visually.',
    text: 'Studio provides a live environment for configuring, testing and refining immersive experiences before publishing.',
    items: [
      'Live preview',
      'Experience presets',
      'Real-time controls',
      'Runtime feedback',
    ],
  },
  {
    number: '06',
    id: 'developers',
    eyebrow: 'Developer API',
    title: 'Powerful architecture with a clear interface.',
    text: 'Developers can extend Aether through predictable APIs instead of working around tightly coupled effects.',
    items: [
      'Readable configuration',
      'Modular services',
      'Lifecycle events',
      'Extensible architecture',
    ],
  },
];
import SiteFooter from '../components/SiteFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Explore Aether's audio, lighting, particle, runtime, Studio and developer capabilities."
    />
    <title>Features — Aether</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PostHog />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Aether home">
        <img
          src="/brand/aether-mark.svg"
          alt=""
          class="brand-logo"
          width="80"
          height="80"
        />
        <span>Aether</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="/">Overview</a>
        <a href="/features/" aria-current="page">Features</a>
        <a href="/studio/">Studio</a>
        <a
          href="https://github.com/Benchelt/createaether-website"
          target="_blank"
          rel="noreferrer"
        >
          Developers
        </a>
      </nav>
    </header>

    <main>
      <section class="features-hero">
        <div class="features-hero-grid" aria-hidden="true"></div>

        <div class="features-hero-content">
          <p class="eyebrow">Aether Features</p>

          <h1>Build immersive digital experiences.</h1>

          <p class="features-intro">
            Aether combines adaptive audio, atmospheric visuals and an
            event-driven runtime into one unified experience platform.
          </p>

          <div class="actions">
            <a class="button primary" href="#platform">
              Explore the platform ↓
            </a>

            <a class="button secondary" href="/studio/">
              Launch Studio →
            </a>
          </div>
        </div>
      </section>

      <section class="platform-introduction" id="platform">
        <p class="eyebrow">One unified platform</p>

        <h2>Immersion without complexity.</h2>

        <p>
          Aether does not treat sound, lighting and particles as disconnected
          effects. Every capability works through a shared runtime so complete
          experiences remain consistent, maintainable and extensible.
        </p>
      </section>

      <section
        class="features-grid"
        aria-label="Aether platform features"
      >
        {
          features.map((feature) => (
            <article class="feature-card" id={feature.id}>
              <div class="feature-number" aria-hidden="true">
                {feature.number}
              </div>

              <p class="eyebrow">{feature.eyebrow}</p>
              <h2>{feature.title}</h2>
              <p>{feature.text}</p>

              <ul>
                {feature.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="developer-example">
        <div>
          <p class="eyebrow">Designed for clarity</p>
          <h2>A readable developer experience.</h2>

          <p>
            Experiences are controlled through a predictable runtime API,
            allowing systems to communicate without becoming tightly coupled.
          </p>
        </div>

        <pre><code>{`Aether.Experience.load('Temple');

const audio = Aether.Services.get('audio');

Aether.Events.on('experience:loaded', (experience) => {
  console.log(experience);
});`}</code></pre>
      </section>

      <section class="features-cta">
        <p class="eyebrow">Start creating</p>
        <h2>One platform. Infinite atmospheres.</h2>

        <p>
          Build digital experiences that people do not just use—they remember.
        </p>

        <div class="actions">
          <a class="button primary" href="/studio/">
            Explore Studio →
          </a>

          <a
            class="button secondary"
            href="https://github.com/Benchelt/createaether-website"
            target="_blank"
            rel="noreferrer"
          >
            View GitHub
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .features-hero {
    position: relative;
    min-height: 72vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    padding: 10rem clamp(1.5rem, 6vw, 7rem) 6rem;
  }

  .features-hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(121, 225, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(121, 225, 255, 0.08) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .features-hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }

  .features-hero h1 {
    max-width: 820px;
    margin: 1rem 0 1.5rem;
    font-size: clamp(3.4rem, 8vw, 7.2rem);
    line-height: 0.94;
  }

  .features-intro {
    max-width: 720px;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.75;
  }

  .platform-introduction,
  .developer-example,
  .features-cta {
    width: min(1180px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .platform-introduction {
    padding: 8rem 0 5rem;
    max-width: 900px;
    text-align: center;
  }

  .platform-introduction h2,
  .features-cta h2 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
  }

  .platform-introduction > p:last-child,
  .features-cta > p {
    max-width: 760px;
    margin-inline: auto;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .features-grid {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-bottom: 8rem;
  }

  .feature-card {
    position: relative;
    min-height: 440px;
    padding: clamp(2rem, 4vw, 3.25rem);
    border: 1px solid rgba(151, 225, 255, 0.14);
    border-radius: 1.5rem;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        rgba(24, 38, 59, 0.58),
        rgba(6, 13, 25, 0.72)
      );
  }

  .feature-card::after {
    content: '';
    position: absolute;
    width: 220px;
    height: 220px;
    right: -100px;
    bottom: -120px;
    border-radius: 50%;
    background: rgba(69, 210, 255, 0.08);
    filter: blur(35px);
    pointer-events: none;
  }

  .feature-number {
    margin-bottom: 4rem;
    color: rgba(151, 225, 255, 0.38);
    font-family: monospace;
    letter-spacing: 0.18em;
  }

  .feature-card h2 {
    margin: 0.8rem 0 1rem;
    max-width: 520px;
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .feature-card > p:last-of-type {
    line-height: 1.75;
  }

  .feature-card ul {
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    list-style: none;
  }

  .feature-card li::before {
    content: '—';
    margin-right: 0.7rem;
    color: rgba(121, 225, 255, 0.9);
  }

  .developer-example {
    padding: 7rem 0;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .developer-example h2 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.5rem, 4vw, 4rem);
  }

  .developer-example p {
    line-height: 1.8;
  }

  .developer-example pre {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    overflow-x: auto;
    border: 1px solid rgba(151, 225, 255, 0.16);
    border-radius: 1.25rem;
    background: rgba(3, 9, 18, 0.88);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
  }

  .developer-example code {
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .features-cta {
    margin-bottom: 5rem;
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem);
    text-align: center;
    border: 1px solid rgba(151, 225, 255, 0.15);
    border-radius: 1.75rem;
    background:
      radial-gradient(
        circle at top,
        rgba(48, 191, 255, 0.12),
        transparent 58%
      ),
      rgba(8, 17, 31, 0.62);
  }

  .features-cta .actions {
    justify-content: center;
  }

  @media (max-width: 800px) {
    .features-grid,
    .developer-example {
      grid-template-columns: 1fr;
    }

    .features-hero {
      min-height: auto;
      padding-top: 9rem;
    }

    .feature-card {
      min-height: auto;
    }
  }
</style>
