---
import StudioLayout from '../layouts/StudioLayout.astro';
import ExperienceCard from '../components/studio/ExperienceCard.astro';
import MyExperiencesPanel from '../components/studio/MyExperiencesPanel.astro';
import { experiences } from '../data/experiences';
import { backgroundSource } from '../lib/player/BackgroundChoices';
---

<StudioLayout
  title="Scene library"
  description="Choose a scene and create your own immersive environment."
>
  <section class="studio-dashboard">
    <header class="studio-dashboard__header">
      <div>
        <p class="studio-dashboard__eyebrow">Aether Studio</p>
        <h1>Scene library</h1>
        <p class="studio-dashboard__intro">
          Play a scene without a timer, open the scene editor to customise it, or return to your saved creations. For a timed session with optional guidance, <a href="/studio/guided-relaxation/">choose a relaxation session</a>.
        </p>
      </div>

    </header>
    <nav class="library-tabs" aria-label="Scene collections">
      <a href="#experience-library" data-library-tab="explore" aria-current="page">Explore</a>
      <a href="#my-experiences-title" data-library-tab="saved">My saved</a>
    </nav>
    <div id="saved-library-panel" data-library-panel="saved"><MyExperiencesPanel /></div>

    <section id="experience-library" class="studio-dashboard__experiences" data-library-panel="explore">
      <div class="studio-dashboard__section-heading">
        <div>
          <p class="studio-dashboard__workspace-label">Shared scene collection</p>
          <h2>Choose a scene</h2>
        </div>


      </div>

      <div class="studio-dashboard__experience-grid">
        {
          experiences.map((experience) => (
            <ExperienceCard
              sceneId={experience.id}
              cover={backgroundSource(experience)}
              title={experience.name}
              description={experience.description}
              href={experience.href}
              playHref={`/studio/listen/?scene=${experience.id}`}
            />
          ))
        }
      </div>


    </section>

  </section>
</StudioLayout>

<style>
  .studio-dashboard {
    width: min(100%, 90rem);
    margin-inline: auto;
  }

  .studio-dashboard__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 2.25rem;
  }

  .studio-dashboard__eyebrow {
    margin: 0 0 0.75rem;
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .studio-dashboard h1 {
    max-width: 50rem;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .studio-dashboard__intro {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.75;
  }

  .studio-dashboard__action {
    border: 1px solid rgba(125, 211, 252, 0.35);
    border-radius: 0.8rem;
    background: linear-gradient(135deg, #0284c7, #2563eb);
    padding: 0.8rem 1rem;
    color: white;
    text-decoration: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
    white-space: nowrap;
    box-shadow: 0 1rem 2.5rem rgba(2, 132, 199, 0.18);
  }

  .studio-dashboard__action:hover {
    transform: translateY(-2px);
  }

  .studio-dashboard__metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .studio-dashboard__runtime {
    margin-top: 1.25rem;
    padding: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .studio-dashboard__section-heading h2 {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.25rem;
  }

  .studio-dashboard__section-heading > span {
    color: #64748b;
    font-size: 0.78rem;
  }

  .studio-dashboard__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .studio-dashboard__experiences {
    margin-top: 1.25rem;
    padding: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__section-heading a {
    color: #7dd3fc;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .studio-dashboard__section-heading a:hover {
    color: #bae6fd;
  }

  .studio-dashboard__experience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .studio-dashboard__workspace {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.25rem;
    padding: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__workspace-label {
    margin: 0 0 0.55rem;
    color: #38bdf8;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .studio-dashboard__workspace h2 {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.25rem;
  }

  .studio-dashboard__workspace p:last-child {
    max-width: 42rem;
    margin: 0.8rem 0 0;
    color: #94a3b8;
    line-height: 1.7;
  }

  .studio-dashboard__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgba(52, 211, 153, 0.2);
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.5rem 0.75rem;
    color: #6ee7b7;
    font-size: 0.76rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .studio-dashboard__status span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0.8rem rgba(52, 211, 153, 0.75);
  }

  @media (max-width: 1100px) {
    .studio-dashboard__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .studio-dashboard__experience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .studio-dashboard__experience-grid { grid-template-columns: 1fr !important; }
    .studio-dashboard__experiences { padding: 1rem; }
  }

  @media (max-width: 720px) {
    .studio-dashboard__header,
    .studio-dashboard__workspace {
      flex-direction: column;
    }

    .studio-dashboard__action {
      width: 100%;
    }

    .studio-dashboard__metrics,
    .studio-dashboard__services,
    .studio-dashboard__experience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .studio-dashboard__section-heading {
      flex-direction: column;
    }
  }
</style>

<style>
.podcast-dashboard-card { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:22px; margin-bottom:24px; background:linear-gradient(135deg,rgba(15,23,42,.82),rgba(8,15,29,.72)); border:1px solid rgba(148,163,184,.14); border-radius:1.35rem; color:#7dd3fc; text-decoration:none; }
.podcast-dashboard-card strong { display:block; font-size:18px; margin-bottom:6px; color:#e2e8f0; }
.podcast-dashboard-card small { color:#94a3b8; line-height:1.6; }
.podcast-dashboard-card>span:last-child { font-size:12px; }
.podcast-dashboard-card:hover { border-color:rgba(56,189,248,.55); }
.podcast-dashboard-card__label { display:block; margin-bottom:.55rem; color:#38bdf8; font-size:.7rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
.podcast-dashboard-card:focus-visible { outline:2px solid #7dd3fc; outline-offset:3px; }
@media(max-width:600px) { .podcast-dashboard-card { flex-direction:column; align-items:flex-start; } }
</style>

<style is:global>
  #experience-library .experience-card { display: flex; flex-direction: column; min-width: 0; gap: 0; padding: 0; overflow: hidden; }
  #experience-library .experience-card__image-link { display: block; flex: 0 0 auto; width: 100%; }
  #experience-library .experience-card .experience-card__cover { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center; }
  #experience-library .experience-card__content { flex: 1; margin: 0; padding: 1.1rem 1.1rem 0; }
  #experience-library .experience-card h3 { margin: 0; color: #f8fafc; font-size: 1.15rem; line-height: 1.35; }
  #experience-library .experience-card h3 a,
  #experience-library .experience-card h3 a:visited { color: #f8fafc; text-decoration: none; }
  #experience-library .experience-card h3 a:hover { color: #7dd3fc; }
  #experience-library .experience-card p { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3.2em; margin: .65rem 0 0; line-height: 1.6; }
  #experience-library .experience-card__footer { display: block; margin: auto 0 0; padding: 1rem 1.1rem 1.1rem; }
  #experience-library .experience-card__button { display: flex; box-sizing: border-box; align-items: center; justify-content: center; width: 100%; min-height: 2.75rem; padding: .65rem .5rem; line-height: 1.3; font-size: .9rem; text-decoration: none; color: white; background: #2563eb; border-radius: 10px; }
  #experience-library .experience-card__button:hover { background: #1d4ed8; }
  #experience-library .experience-card a:focus-visible { outline: 2px solid #7dd3fc; outline-offset: -3px; }
</style>

<style is:global>
  #experience-library .experience-card__button {
    display: inline-flex;
    width: auto;
    padding: .65rem 1rem;
  }
  .my-experiences .my-experiences__continue {
    flex: 0 0 auto;
    width: auto;
    padding: .65rem 1rem;
  }
  .my-experiences .my-experiences__menu { margin-left: auto; }
</style>

<style is:global>
  .studio-dashboard a.podcast-dashboard-card {
    background: linear-gradient(135deg, rgba(15,23,42,.82), rgba(8,15,29,.72));
    border: 1px solid rgba(148,163,184,.14);
    border-radius: 1.35rem;
    color: #7dd3fc;
    box-shadow: inset 0 1px rgba(255,255,255,.025);
  }
  .studio-dashboard a.podcast-dashboard-card:hover { border-color: rgba(56,189,248,.55); }
  .studio-dashboard a.podcast-dashboard-card strong { color: #e2e8f0; }
  .studio-dashboard a.podcast-dashboard-card small { color: #94a3b8; }
  .studio-dashboard a.podcast-dashboard-card .podcast-dashboard-card__label {
    display: block; margin-bottom: .55rem; color: #38bdf8;
    font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  }
  .studio-dashboard a.podcast-dashboard-card > span:last-child { color: #7dd3fc; }
</style>

<script>
 const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-library-tab]')];
 function selectCollection() {
   const saved = location.hash === '#my-experiences-title' || (!location.hash && new URLSearchParams(location.search).has('saved'));
   document.querySelectorAll<HTMLElement>('[data-library-panel]').forEach(panel => panel.hidden = (panel.dataset.libraryPanel === 'saved') !== saved);
   tabs.forEach(tab => { if ((tab.dataset.libraryTab === 'saved') === saved) tab.setAttribute('aria-current','page'); else tab.removeAttribute('aria-current'); });
 }
 window.addEventListener('hashchange', selectCollection);
 selectCollection();
</script>
<style is:global>
 [data-library-panel][hidden] {display:none!important;}
 .library-tabs {display:flex;gap:12px;margin-bottom:20px;}
 .library-tabs a {padding:12px 20px;border:1px solid #334155;border-radius:10px;color:#cbd5e1;text-decoration:none;}
 .library-tabs a[aria-current] {background:#193d5a;border-color:#38bdf8;color:#fff;}
 .library-tabs a:focus-visible {outline:2px solid #7dd3fc;outline-offset:3px;}
 #experience-library .experience-card__footer {display:flex;gap:10px;flex-wrap:wrap;}
 #experience-library .experience-card__customise {background:#243247;}
</style>
