---
import StudioLayout from '../layouts/StudioLayout.astro';
import MetricCard from '../components/studio/MetricCard.astro';
import StatusCard from '../components/studio/StatusCard.astro';
import ExperienceCard from '../components/studio/ExperienceCard.astro';
import MyExperiencesPanel from '../components/studio/MyExperiencesPanel.astro';
import { experiences } from '../data/experiences';
---

<StudioLayout
  title="Aether Atmosphere Composer"
  description="Create and tune atmospheric experiences in the Aether working MVP."
>
  <section class="studio-dashboard">
    <header class="studio-dashboard__header">
      <div>
        <p class="studio-dashboard__eyebrow">Aether Atmosphere Composer</p>
        <h1>Shape atmospheric experiences.</h1>
        <p class="studio-dashboard__intro">
          Adjust the working MVP systems, tune each environment and iterate
          locally in the browser before refining the next version.
        </p>
      </div>

      <a href="#experience-library" class="studio-dashboard__action">
  Choose an experience
</a>
    </header>

    <section class="studio-dashboard__metrics" aria-label="Workspace overview">
      <MetricCard
        title="Experiences"
        value="5"
description="Working MVP presets"
      />

      <MetricCard
        title="Editable systems"
        value="4"
        description="Audio, lighting, particles, fog"
      />

      <MetricCard
        title="Preview"
        value="Live"
        description="Browser-based runtime"
      />

      <MetricCard
        title="Storage"
        value="Local"
        description="Saved in-browser"
      />
    </section>

    <section class="studio-dashboard__runtime">
      <div class="studio-dashboard__section-heading">
        <div>
          <p class="studio-dashboard__workspace-label">Working MVP</p>
          <h2>Available now</h2>
        </div>

        <span>Local-first system</span>
      </div>

      <div class="studio-dashboard__services">
        <StatusCard
          title="Atmosphere editor"
          status="Working"
          colour="green"
        />

        <StatusCard
          title="Live preview"
          status="Enabled"
          colour="green"
        />

        <StatusCard
          title="Local saving"
          status="Available"
          colour="green"
        />

        <StatusCard
          title="Marketplace"
          status="Planned"
          colour="yellow"
        />
      </div>
    </section>

    <section id="experience-library" class="studio-dashboard__experiences">
      <div class="studio-dashboard__section-heading">
        <div>
          <p class="studio-dashboard__workspace-label">Experience library</p>
          <h2>Recent experiences</h2>
        </div>


      </div>

      <div class="studio-dashboard__experience-grid">
        {
          experiences.map((experience) => (
            <ExperienceCard
              title={experience.name}
              description={experience.description}
              status={experience.status}
              href={experience.href}
            />
          ))
        }
      </div>

      <MyExperiencesPanel />
    </section>

    <section class="studio-dashboard__workspace">
      <div>
        <p class="studio-dashboard__workspace-label">Workspace status</p>
        <h2>Aether works as a local MVP foundation.</h2>
        <p>
          The available system covers editable atmosphere presets, live browser
          preview and local experience storage. Marketplace, SDK, account
          services and publishing remain planned in development.
        </p>
      </div>

      <span class="studio-dashboard__status">
        <span aria-hidden="true"></span>
        Working MVP
      </span>
    </section>
  </section>
</StudioLayout>

<style>
  .studio-dashboard {
    width: min(100%, 90rem);
    margin-inline: auto;
  }

  .studio-dashboard__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 2.25rem;
  }

  .studio-dashboard__eyebrow {
    margin: 0 0 0.75rem;
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .studio-dashboard h1 {
    max-width: 50rem;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .studio-dashboard__intro {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.75;
  }

  .studio-dashboard__action {
    border: 1px solid rgba(125, 211, 252, 0.35);
    border-radius: 0.8rem;
    background: linear-gradient(135deg, #0284c7, #2563eb);
    padding: 0.8rem 1rem;
    color: white;
    text-decoration: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
    white-space: nowrap;
    box-shadow: 0 1rem 2.5rem rgba(2, 132, 199, 0.18);
  }

  .studio-dashboard__action:hover {
    transform: translateY(-2px);
  }

  .studio-dashboard__metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .studio-dashboard__runtime {
    margin-top: 1.25rem;
    padding: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .studio-dashboard__section-heading h2 {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.25rem;
  }

  .studio-dashboard__section-heading > span {
    color: #64748b;
    font-size: 0.78rem;
  }

  .studio-dashboard__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .studio-dashboard__experiences {
    margin-top: 1.25rem;
    padding: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__section-heading a {
    color: #7dd3fc;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .studio-dashboard__section-heading a:hover {
    color: #bae6fd;
  }

  .studio-dashboard__experience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .studio-dashboard__workspace {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.25rem;
    padding: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__workspace-label {
    margin: 0 0 0.55rem;
    color: #38bdf8;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .studio-dashboard__workspace h2 {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.25rem;
  }

  .studio-dashboard__workspace p:last-child {
    max-width: 42rem;
    margin: 0.8rem 0 0;
    color: #94a3b8;
    line-height: 1.7;
  }

  .studio-dashboard__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgba(52, 211, 153, 0.2);
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.5rem 0.75rem;
    color: #6ee7b7;
    font-size: 0.76rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .studio-dashboard__status span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0.8rem rgba(52, 211, 153, 0.75);
  }

  @media (max-width: 1100px) {
    .studio-dashboard__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .studio-dashboard__experience-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .studio-dashboard__header,
    .studio-dashboard__workspace {
      flex-direction: column;
    }

    .studio-dashboard__action {
      width: 100%;
    }

    .studio-dashboard__metrics,
    .studio-dashboard__services,
    .studio-dashboard__experience-grid {
      grid-template-columns: 1fr;
    }

    .studio-dashboard__section-heading {
      flex-direction: column;
    }
  }
</style>
