---
import BroadcastStage from '../components/studio/BroadcastStage.astro';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="referrer" content="no-referrer" /><title>Aether Show Playback</title></head>
<body>
<main id="show-player" hidden><BroadcastStage /></main>
<section id="show-error" hidden role="alert"><h1>This show link could not be opened</h1><p>Return to Podcast &amp; Stream and create a new link.</p><a href="/studio/podcast/">Open Podcast &amp; Stream</a></section>
<script>
import { readBroadcastHash, isLogo } from '../lib/broadcast/BroadcastSettings';
import { createBroadcastController } from '../lib/broadcast/BroadcastController';
const root=document.querySelector<HTMLElement>('.broadcast-stage')!;
const controller=createBroadcastController(root);
let logo='';
function load() {
    const player=document.querySelector<HTMLElement>('#show-player')!, error=document.querySelector<HTMLElement>('#show-error')!;
    try {
        const settings=readBroadcastHash(location.hash);
        player.hidden=false; error.hidden=true;
        controller.update(settings,logo,false); document.title=`${settings.show || 'Your show'} - Aether`;
    } catch { player.hidden=true; error.hidden=false; controller.stop(); }
}
window.addEventListener('message',event=>{
    if (window.parent === window || event.source !== window.parent || event.data?.type !== 'aether-show-logo' || !isLogo(event.data.logo)) return;
    logo=event.data.logo; load();
});
load();
if(window.parent!==window) window.parent.postMessage('aether-show-ready','*');
window.addEventListener('hashchange',load);
window.addEventListener('pagehide',event=>{if(!event.persisted)controller.destroy();});
</script>
</body></html>
<style is:global>
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;font-family:system-ui;color:white}
#show-player:not([hidden]){width:100%;height:100%;display:grid;place-items:center}
#show-player .broadcast-stage{width:min(100vw,177.7778vh);height:min(100vh,56.25vw);border-radius:0}
#show-error{max-width:540px;padding:40px;line-height:1.6}#show-error a{color:#8ee5c1}
</style>
